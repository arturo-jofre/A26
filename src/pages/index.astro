---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import Button from "../components/Button.astro";
import ProjectCard from "../components/ProjectCard.astro";
import OrbitalSection from "../components/OrbitalSection.astro";
import SectionFrame from "../components/SectionFrame.astro";
import Kicker from "../components/Kicker.astro";
import HudReadout from "../components/HudReadout.astro";
import MonoMicrocopy from "../components/MonoMicrocopy.astro";

import { getCollection } from "astro:content";

const isDev = import.meta.env.DEV;
const allProjects = await getCollection("proyectos");
const projectsByTag = allProjects
	.filter(
		(project) =>
			project.data.featured &&
			(isDev
				? !project.data.archived
				: !project.data.draft && !project.data.archived)
	)
	.sort(
		(a, b) =>
			new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
	)
	.slice(0, 4);

const hudRows = [
	{ key: "EXPERIENCIA", value: "14+ AÑOS" },
	{ key: "PROYECTOS", value: "50+" },
	{ key: "INDUSTRIAS", value: "8+" },
	{ key: "PÁVLOV", value: "2015" },
];
---

<Layout title="Arturo Jofré - Product Designer">
	<Navbar />
	<main id="main" class="flex-grow">
		<!-- HERO -->
		<section
			id="hero"
			class="relative mx-auto max-w-6xl overflow-hidden pt-32 pb-24 px-4 sm:px-8 lg:px-12"
		>
			<!-- Hero glow: the signature accent. The only atmospheric decoration on the page. -->
			<div class="hero-glow" aria-hidden="true"></div>

			<div class="relative z-10">
				<SectionFrame tone="strong" size="md" class="p-8 sm:p-10">
					<div class="max-w-3xl space-y-8">
						<!-- Status badge: availability signal, mono label + Bench Orange dot.
						     role="status" + aria-live="polite" announces the state to screen readers. -->
						<div
							class="hero-animate inline-flex items-center gap-2 border border-border rounded-full px-4 py-1.5 text-xs font-mono text-muted tracking-widest uppercase"
							role="status"
							aria-live="polite"
						>
							<span class="relative flex h-1.5 w-1.5" aria-hidden="true">
								<span
									class="animate-ping absolute inline-flex h-full w-full rounded-full bg-accent opacity-75"
								></span>
								<span
									class="relative inline-flex rounded-full h-1.5 w-1.5 bg-accent"
								></span>
							</span>
							Disponible para proyectos
						</div>

						<h1
							class="hero-animate text-[clamp(2.25rem,6.5vw,4.5rem)] font-bold leading-[0.95]"
						>
							Arturo Jofré López
							<br />
							<span class="text-accent">Product Designer</span>
						</h1>

						<p
							class="hero-animate text-lg md:text-xl text-muted max-w-2xl leading-relaxed text-pretty"
						>
							14 años diseñando productos digitales para gobierno,
							salud, finanzas, retail, logística y recursos humanos.
						</p>

						<div
							class="hero-animate flex flex-col sm:flex-row gap-4 items-start"
						>
							<Button
								variant="primary"
								size="lg"
								href="https://calendar.app.google/ZE6YQWLGgc8WUZSDA"
							>
								Agenda una reunión
							</Button>
							<Button variant="lined" size="md" href="/proyectos">
								[ VER PROYECTOS ]
							</Button>
						</div>

						<MonoMicrocopy class="pt-2">
							// STATUS: AVAILABLE · REPLY &lt; 24H · SANTIAGO, CL
						</MonoMicrocopy>
					</div>
				</SectionFrame>
			</div>
		</section>

		<!-- ────────────────────────── PROYECTOS DESTACADOS ───────────────────── -->
		<section class="relative py-24">
			<div class="mx-auto max-w-6xl px-4 sm:px-8 lg:px-12">
				<div class="flex items-end justify-between mb-12 gap-4 flex-wrap">
					<div>
						<Kicker class="mb-2">35+ PROYECTOS // 8 INDUSTRIAS</Kicker>
						<h2 class="text-4xl font-bold tracking-tight text-balance">
							Últimos proyectos
						</h2>
					</div>
					<Button variant="lined" size="md" href="/proyectos">
						[ VER TODOS ]
					</Button>
				</div>

				<div
					class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-px bg-foreground/10"
				>
					{
						projectsByTag.map((project) => (
							<ProjectCard
								title={project.data.title}
								img={project.data.thumb}
								link={`/proyectos/${project.id}`}
								description={project.data.description}
								year={project.data.year}
							/>
						))
					}
				</div>
			</div>
		</section>

		<!-- ────── CÓMO TRABAJO ────── -->
		<section class="relative py-24">
			<div class="mx-auto max-w-6xl px-4 sm:px-8 lg:px-12">
				<div class="mb-10 max-w-3xl space-y-2">
					<Kicker>
						DISCIPLINAS // RESEARCH — DESIGN — SYSTEMS
					</Kicker>
					<h2
						class="text-4xl font-bold tracking-tight text-balance"
					>
						Cómo trabajo
					</h2>
				</div>

				<div
					class="max-w-3xl space-y-6 text-lg text-muted leading-relaxed text-pretty"
				>
					<p>
						Investigo, diseño y entrego. Empiezo con research para
						entender el problema — hablo con usuarios, mapeo
						fricciones, priorizo oportunidades. Paso a diseño con
						wireframes, prototipos y sistemas. Itero con el equipo
						hasta que la solución es clara. Termino con la entrega
						al equipo de desarrollo, con la especificación y los
						assets listos para construir.
					</p>
					<p>
						Mi práctica cubre UX research, product design, web
						development y brand identity. Trabajo con empresas y
						startups en sectores como gobierno, salud, finanzas,
						retail, logística y recursos humanos, en roles
						individuales y de liderazgo, llevando productos desde la
						investigación hasta el lanzamiento.
					</p>
				</div>
			</div>
		</section>

		<!-- ──── SOBRE MÍ ─── -->
		<section class="relative py-24">
			<div class="mx-auto max-w-6xl px-4 sm:px-8 lg:px-12">
				<SectionFrame tone="strong" size="md" class="p-8 sm:p-10">
					<div class="grid lg:grid-cols-[1.4fr_1fr] gap-12 lg:gap-16 items-center">
						<div class="space-y-6">
							<Kicker>
								SEP 2011 — PRESENTE // 7 ROLES · 4 EMPRESAS
							</Kicker>
							<h2
								class="text-4xl font-bold tracking-tight text-balance"
							>
								14 años diseñando productos digitales
							</h2>
							<div class="space-y-4 text-muted leading-relaxed text-pretty">
								<p>
									Diseñador UX Senior en Cleverit. Antes: Lead
									UX en Aureolab, Diseñador UI/UX en Agencia
									Land, diseñador web en PVW Publicidad. He
									llevado productos desde la investigación
									hasta el lanzamiento en gobierno, salud,
									finanzas, retail, logística y recursos
									humanos.
								</p>
								<p>
									En 2015 cofundé Pávlov, una consultora de
									diseño. Diseño gráfico en Duoc UC; Arquitectura
									de Información y Experiencia de Usuario en
									Universidad Central.
								</p>
							</div>
							<Button variant="lined" size="md" href="/sobre-mi">
								[ LEER CV COMPLETO ]
							</Button>
						</div>

						<HudReadout
							rows={hudRows}
							label="Trayectoria profesional"
							class="lg:self-start"
						/>
					</div>
				</SectionFrame>
			</div>
		</section>

		<!-- ────────────────────────── ORBITAL (signature) ────────────────────────── -->
		<OrbitalSection />
	</main>
	<Footer />
</Layout>

<script>
	import { animate, stagger, inView } from "motion";

	const prefersReducedMotion = window.matchMedia(
		"(prefers-reduced-motion: reduce)"
	).matches;

	let cleanupFns: (() => void)[] = [];

	function destroyAnimations() {
		cleanupFns.forEach((fn) => fn());
		cleanupFns = [];
	}

	function initAnimations() {
		destroyAnimations();
		if (prefersReducedMotion) return;

		const hero = document.querySelector("#hero");
		if (hero) {
			const animator = animate(
				".hero-animate",
				{ opacity: [0, 1], y: [12, 0] },
				{ delay: stagger(0.08), duration: 0.6 }
			);
			cleanupFns.push(() => animator.stop());
		}

		document.querySelectorAll("section").forEach((section) => {
			const stop = inView(
				section,
				(target) => {
					animate(
						target.querySelectorAll(
							"h2, p, .grid > *, dl > *"
						),
						{ opacity: [0, 1], y: [16, 0] },
						{ delay: stagger(0.05), duration: 0.55 }
					);
				},
				{ amount: 0.15, once: true }
			);
			cleanupFns.push(stop);
		});
	}

	document.addEventListener("astro:after-swap", destroyAnimations);
	document.addEventListener("astro:page-load", initAnimations);
</script>
