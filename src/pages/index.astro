---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import Button from "../components/Button.astro";
import ProjectCard from "../components/ProjectCard.astro";
import OrbitalSection from "../components/OrbitalSection.astro";
import SectionFrame from "../components/SectionFrame.astro";
import Kicker from "../components/Kicker.astro";
import HudReadout from "../components/HudReadout.astro";
import MonoMicrocopy from "../components/MonoMicrocopy.astro";
import Badge from "../components/Badge.astro";

import { getCollection } from "astro:content";

const isDev = import.meta.env.DEV;
const allProjects = await getCollection("proyectos");
const projectsByTag = allProjects
	.filter(
		(project) =>
			project.data.featured &&
			(isDev
				? !project.data.archived
				: !project.data.draft && !project.data.archived)
	)
	.sort(
		(a, b) =>
			new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
	)
	.slice(0, 4);

const hudRows = [
	{ key: "EXPERIENCIA", value: "14+ AÑOS" },
	{ key: "PROYECTOS", value: "50+" },
	{ key: "INDUSTRIAS", value: "8+" },
	{ key: "PÁVLOV", value: "2015" },
];
---

<Layout title="Arturo Jofré - Product Designer">
	<Navbar />
	<main id="main" class="flex-grow">
		<!-- HERO -->
		<section
			id="hero"
			class="relative mx-auto max-w-6xl overflow-hidden pt-32 pb-24 px-4 sm:px-8 lg:px-12"
		>
			
			<!-- Line background: named backdrop for the hero. Static, masked toward the fold edge. -->
			<div
				class="line-bg-foreground absolute inset-0 [mask-image:linear-gradient(to_bottom,black,transparent_90%)]"
				aria-hidden="true"
			></div>

			<div class="relative z-10">
				<SectionFrame tone="accent" size="md" class="py-10">
					<div class="max-w-3xl space-y-8" data-reveal-load>
						<!-- Status badge: availability signal, mono label + Bench Orange dot.
						     role="status" + aria-live="polite" announces the state to screen readers. -->
						<Badge
							variant="status"
							data-reveal
							role="status"
							aria-live="polite"
						>
							Disponible para proyectos
						</Badge>

						<h1
							data-reveal
							class="text-[clamp(2.75rem,6.5vw,4.5rem)] font-bold leading-[0.95]"
						>
							Arturo Jofré López
							<br />
							<span class="font-mono text-accent uppercase">Product Designer</span>
						</h1>

						<p
							data-reveal
							class="text-lg leading-[1.6] text-muted max-w-2xl text-pretty"
						>
							14 años diseñando productos digitales para gobierno,
							salud, finanzas, retail, logística y recursos humanos.
						</p>

						<div
							data-reveal
							class="flex flex-col sm:flex-row gap-4 items-start"
						>
							<Button
								variant="primary"
								size="lg"
								href="https://calendar.app.google/ZE6YQWLGgc8WUZSDA"
							>
								Agenda una reunión
							</Button>
							<Button variant="secondary" size="lg" href="/proyectos">
								Ver proyectos
							</Button>
						</div>

						<MonoMicrocopy class="pt-2" data-reveal>
							// STATUS: AVAILABLE · REPLY &lt; 24H · SANTIAGO, CL
						</MonoMicrocopy>
					</div>
				</SectionFrame>
			</div>
		</section>

		<div class="mx-auto max-w-6xl px-4 sm:px-8 lg:px-12" aria-hidden="true">
			<div class="h-px bg-foreground/10"></div>
		</div>

		<!-- ────────────────────────── PROYECTOS DESTACADOS ───────────────────── -->
		<section class="relative py-24">
			<div class="mx-auto max-w-6xl px-4 sm:px-8 lg:px-12">
				<div
					data-reveal
					class="flex items-end justify-between mb-12 gap-4 flex-wrap"
				>
					<div>
						<Kicker class="mb-2">35+ PROYECTOS // 8 INDUSTRIAS</Kicker>
						<h2
							class="text-[clamp(1.875rem,3.5vw,2.5rem)] font-bold leading-[1.1]"
						>
							Últimos proyectos
						</h2>
					</div>
					<Button variant="link" size="md" href="/proyectos">
						Ver todos
						<span class="text-accent" aria-hidden="true">→</span>
					</Button>
				</div>

				<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3">
					{
						projectsByTag.map((project) => (
							<ProjectCard
								title={project.data.title}
								img={project.data.thumb}
								link={`/proyectos/${project.id}`}
								description={project.data.description}
								year={project.data.year}
							/>
						))
					}
				</div>
			</div>
		</section>

		<div class="mx-auto max-w-6xl px-4 sm:px-8 lg:px-12" aria-hidden="true">
			<div class="h-px bg-foreground/10"></div>
		</div>

		<!-- ────── CÓMO TRABAJO ────── -->
		<section class="relative py-24">
			<div class="mx-auto max-w-6xl px-4 sm:px-8 lg:px-12">
				<div class="mb-10 max-w-3xl space-y-2" data-reveal>
					<Kicker>
						DISCIPLINAS // RESEARCH — DESIGN — SYSTEMS
					</Kicker>
					<h2
						class="text-[clamp(1.875rem,3.5vw,2.5rem)] font-bold leading-[1.1]"
					>
						Cómo trabajo
					</h2>
				</div>

				<div
					data-reveal-list
					class="max-w-2xl space-y-6 text-base leading-[1.65] text-muted text-pretty"
				>
					<p>
						Investigo, diseño y entrego. Empiezo con research para
						entender el problema — hablo con usuarios, mapeo
						fricciones, priorizo oportunidades. Paso a diseño con
						wireframes, prototipos y sistemas. Itero con el equipo
						hasta que la solución es clara. Termino con la entrega
						al equipo de desarrollo, con la especificación y los
						assets listos para construir.
					</p>
					<p>
						Mi práctica cubre UX research, product design, web
						development y brand identity. Trabajo con empresas y
						startups en sectores como gobierno, salud, finanzas,
						retail, logística y recursos humanos, en roles
						individuales y de liderazgo, llevando productos desde la
						investigación hasta el lanzamiento.
					</p>
				</div>
			</div>
		</section>

		<div class="mx-auto max-w-6xl px-4 sm:px-8 lg:px-12" aria-hidden="true">
			<div class="h-px bg-foreground/10"></div>
		</div>

		<!-- ──── SOBRE MÍ ─── -->
		<section class="relative py-24">
			<div class="mx-auto max-w-6xl px-4 sm:px-8 lg:px-12">
				<div
					class="grid lg:grid-cols-[1.4fr_1fr] gap-12 lg:gap-16 items-start"
				>
					<div class="space-y-6" data-reveal>
						<Kicker>
							SEP 2011 — PRESENTE // 7 ROLES · 4 EMPRESAS
						</Kicker>
						<h2
							class="text-[clamp(1.875rem,3.5vw,2.5rem)] font-bold leading-[1.1]"
						>
							14 años diseñando productos digitales
						</h2>
						<div
							class="space-y-4 text-base leading-[1.65] text-muted text-pretty"
						>
							<p>
								Diseñador UX Senior en Cleverit. Antes: Lead
								UX en Aureolab, Diseñador UI/UX en Agencia
								Land, diseñador web en PVW Publicidad. He
								llevado productos desde la investigación
								hasta el lanzamiento en gobierno, salud,
								finanzas, retail, logística y recursos
								humanos.
							</p>
							<p>
								En 2015 cofundé Pávlov, una consultora de
								diseño. Diseño gráfico en Duoc UC; Arquitectura
								de Información y Experiencia de Usuario en
								Universidad Central.
							</p>
						</div>
						<Button variant="secondary" size="md" href="/sobre-mi">
							Leer CV completo
						</Button>
					</div>

					<div data-reveal class="lg:self-start">
						<HudReadout
							rows={hudRows}
							label="Trayectoria profesional"
							framed
						/>
					</div>
				</div>
			</div>
		</section>

		<!-- Signature section break: the accent divider, used once. -->
		<div class="mx-auto max-w-6xl px-4 sm:px-8 lg:px-12" aria-hidden="true">
			<div class="h-px bg-accent/40"></div>
		</div>

		<!-- ────────────────────────── ORBITAL (signature) ────────────────────────── -->
		
	</main>
	<Footer />
</Layout>

