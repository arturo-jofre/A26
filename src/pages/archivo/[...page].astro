---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import Kicker from "../../components/Kicker.astro";
import MonoMicrocopy from "../../components/MonoMicrocopy.astro";

import { getCollection } from "astro:content";

export async function getStaticPaths({ paginate }) {
  const isDev = import.meta.env.DEV;
  const allProjects = await getCollection("proyectos");
  const archived = allProjects
    .filter((p) => (isDev ? true : !p.data.draft) && p.data.archived)
    .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());
  return paginate(archived, { pageSize: 9 });
}

const { page } = Astro.props;

const visible = page.total;
const range = `${page.start + 1}–${Math.min(page.end + 1, page.total)}`;

const years = page.data.map((p) => p.data.year).filter(Boolean) as number[];
const minYear = years.length ? Math.min(...years) : null;
const maxYear = years.length ? Math.max(...years) : null;
const yearRange =
  minYear === maxYear
    ? `${minYear}`
    : `${minYear}–${maxYear}`;
---

<Layout title={`Archivo · Página ${page.currentPage} — Arturo Jofré`}>
  <Navbar />
  <main id="main" class="pt-24 pb-10 flex-grow">
    <div class="mx-auto max-w-6xl px-4 sm:px-8 lg:px-12">
      <!-- ─── HEADER ─── -->
      <section class="py-16 sm:py-20" data-reveal-load>
        <MonoMicrocopy class="mb-6" data-reveal>
          // SECTION_ID: ARCHIVE · INDEX
        </MonoMicrocopy>

        <div class="flex items-end justify-between gap-6 flex-wrap mb-8">
          <div class="max-w-3xl space-y-3">
            <Kicker data-reveal>
              {visible} PROYECTOS // {new Set(page.data.map((p) => p.data.client)).size}+ INDUSTRIAS // {yearRange}
            </Kicker>
            <h1
              data-reveal
              class="text-[clamp(2.25rem,5.5vw,3.75rem)] font-bold leading-[0.98] tracking-[-0.03em] text-balance"
            >
              Archivo
            </h1>
            <p data-reveal class="text-base sm:text-lg text-muted leading-[1.6] text-pretty max-w-2xl">
              Trabajos fuera de portafolio público: proyectos
              confidenciales bajo NDA, versiones anteriores o piezas
              que ya no represento. Acceso en modo lectura.
            </p>
          </div>
          <MonoMicrocopy tone="accent" data-reveal>
            // PÁG. {String(page.currentPage).padStart(2, "0")} / {String(page.lastPage).padStart(2, "0")}
          </MonoMicrocopy>
        </div>
      </section>

      <div class="h-px bg-foreground/10" aria-hidden="true"></div>

      <!-- ─── GRID ─── -->
      <section class="py-12 sm:py-16">
        <div class="flex items-baseline justify-between mb-6 flex-wrap gap-3" data-reveal>
          <MonoMicrocopy>
            // MOSTRANDO {range} DE {page.total}
          </MonoMicrocopy>
          <MonoMicrocopy>
            // ORDENADO POR FECHA · DESC
          </MonoMicrocopy>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3">
          {
            page.data.map((project) => (
              <ProjectCard
                title={project.data.title}
                img={project.data.thumb}
                link={`/proyectos/${project.id}`}
                description={project.data.description}
                year={project.data.year}
                isPrivate={project.data.private}
              />
            ))
          }
        </div>
      </section>

      <!-- ─── PAGINATION ─── -->
      <section
        data-reveal
        class="flex items-center justify-between border-t border-border pt-6 flex-wrap gap-4"
      >
        <div class="inline-flex items-center divide-x divide-border border border-border font-mono text-[10px] uppercase tracking-widest">
          {
            page.url.prev ? (
              <a
                href={page.url.prev}
                class="px-3 py-2 text-muted hover:text-foreground transition-colors"
                aria-label="Página anterior"
              >
                ‹
              </a>
            ) : (
              <span class="px-3 py-2 text-muted/30 cursor-not-allowed">‹</span>
            )
          }
          {
            Array.from({ length: page.lastPage }, (_, i) => i + 1).map((n) => {
              const href = n === 1 ? "/archivo" : `/archivo/${n}`;
              const isCurrent = n === page.currentPage;
              return isCurrent ? (
                <span
                  aria-current="page"
                  class="px-3 py-2 text-accent bg-white/5 tabular-nums"
                >
                  {String(n).padStart(2, "0")}
                </span>
              ) : (
                <a
                  href={href}
                  class="px-3 py-2 text-muted hover:text-foreground transition-colors tabular-nums"
                >
                  {String(n).padStart(2, "0")}
                </a>
              );
            })
          }
          {
            page.url.next ? (
              <a
                href={page.url.next}
                class="px-3 py-2 text-muted hover:text-foreground transition-colors"
                aria-label="Página siguiente"
              >
                ›
              </a>
            ) : (
              <span class="px-3 py-2 text-muted/30 cursor-not-allowed">›</span>
            )
          }
        </div>

        <MonoMicrocopy>
          // TOTAL {page.total} · PAGE_SIZE 9
        </MonoMicrocopy>
      </section>
    </div>
  </main>
  <Footer />
</Layout>

