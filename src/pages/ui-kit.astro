<script>
	function setupCompositionForm() {
		const form = document.querySelector<HTMLFormElement>(
			"[data-composition-form]",
		);
		if (!form) return;

		const status = form.querySelector<HTMLElement>("[data-form-status]");
		const statusText = form.querySelector<HTMLElement>(
			"[data-form-status-text]",
		);
		const submit = form.querySelector<HTMLButtonElement>(
			"[data-form-submit]",
		);
		const messageInput = form.querySelector<HTMLTextAreaElement>(
			"[data-form-message]",
		);
		const nameInput = form.querySelector<HTMLInputElement>(
			"[data-form-name]",
		);
		const emailInput = form.querySelector<HTMLInputElement>(
			"[data-form-email]",
		);
		const chars = form.querySelector<HTMLElement>("[data-form-chars]");
		const alertEmpty = form.querySelector<HTMLElement>(
			"[data-form-alert-empty]",
		);
		const alertEmail = form.querySelector<HTMLElement>(
			"[data-form-alert-email]",
		);
		const alertSuccess = form.querySelector<HTMLElement>(
			"[data-form-alert-success]",
		);

		if (
			!status ||
			!statusText ||
			!submit ||
			!messageInput ||
			!nameInput ||
			!emailInput ||
			!chars ||
			!alertEmpty ||
			!alertEmail ||
			!alertSuccess
		) {
			return;
		}

		const statusClass = {
			empty: "border border-border text-muted",
			partial: "border border-border text-muted",
			ready: "border border-border text-muted",
			sent: "border border-accent/50 text-accent",
		} as const;

		const hideAlerts = () => {
			alertEmpty.hidden = true;
			alertEmail.hidden = true;
			alertSuccess.hidden = true;
		};

		const setStatus = (
			text: string,
			state: keyof typeof statusClass,
		) => {
			statusText.textContent = text;
			status.className = statusClass[state];
		};

		const updateChars = () => {
			chars.textContent = String(messageInput.value.length);
		};

		const updateStatus = () => {
			if (statusText.dataset.state === "sent") return;

			const hasAny = [nameInput, emailInput, messageInput].some(
				(i) => i.value.trim().length > 0,
			);
			const hasAll =
				nameInput.value.trim() &&
				emailInput.value.trim() &&
				messageInput.value.trim();

			if (hasAll) {
				setStatus("Listo para enviar", "ready");
			} else if (hasAny) {
				setStatus("Borrador parcial", "partial");
			} else {
				setStatus("Borrador", "empty");
			}
		};

		setStatus("Borrador", "empty");
		updateChars();

		messageInput.addEventListener("input", updateChars);
		form.addEventListener("input", updateStatus);

		form.addEventListener("submit", (e) => {
			e.preventDefault();
			hideAlerts();

			const name = nameInput.value.trim();
			const email = emailInput.value.trim();
			const message = messageInput.value.trim();

			if (!name || !email || !message) {
				alertEmpty.hidden = false;
				return;
			}

			const emailValid = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
			if (!emailValid) {
				alertEmail.hidden = false;
				return;
			}

			alertSuccess.hidden = false;
			submit.disabled = true;
			submit.textContent = "Enviado";
			setStatus("Enviado", "sent");
			statusText.dataset.state = "sent";
		});

		form.addEventListener("reset", () => {
			setTimeout(() => {
				hideAlerts();
				submit.disabled = false;
				submit.textContent = "Enviar mensaje";
				delete statusText.dataset.state;
				setStatus("Borrador", "empty");
				updateChars();
			}, 0);
		});
	}

	document.addEventListener("astro:page-load", setupCompositionForm);
	document.addEventListener("astro:after-swap", setupCompositionForm);
</script>
