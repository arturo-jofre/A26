---
import Layout from "../layouts/Layout.astro";
import Button from "../components/Button.astro";
import Badge from "../components/Badge.astro";
import Kicker from "../components/Kicker.astro";
import SectionFrame from "../components/SectionFrame.astro";
import HudReadout from "../components/HudReadout.astro";
import MonoMicrocopy from "../components/MonoMicrocopy.astro";
import Alert from "../components/Alert.astro";

const hudRows = [
	{ key: "EXPERIENCIA", value: "14+ AÑOS" },
	{ key: "PROYECTOS", value: "50+" },
	{ key: "INDUSTRIAS", value: "8+" },
	{ key: "PÁVLOV", value: "2015" },
];
---

<Layout title="A26 — UI Kit">
	<main class="min-h-screen px-4 sm:px-8 lg:px-12 py-16 sm:py-20">
		<div class="mx-auto max-w-6xl space-y-24">
			<!-- ─── Header ─── -->
			<header class="space-y-4 max-w-3xl">
				<Kicker>DESIGN SYSTEM · WORKBENCH + NERV · v0.5.0</Kicker>
				<h1
					class="text-[clamp(2.75rem,6.5vw,4.5rem)] font-bold leading-[0.95]"
				>
					A26 — UI Kit.
				</h1>
				<p class="text-base sm:text-lg text-muted leading-relaxed text-pretty">
					Banco de pruebas visual del design system. Diez
					secciones: buttons, typography, form controls, badges,
					cards, data readouts, navigation, feedback, frames &
					dividers, y §10 composition — un formulario de contacto
					con validación real que demuestra los componentes
					<Button variant="link" size="md" class="inline-flex text-base sm:text-lg -mx-1" href="#composition">en conjunto <span class="text-accent" aria-hidden="true">↓</span></Button>.
					Cada pieza es el componente Astro que vive en
					<code class="font-mono text-foreground">src/components/</code>;
					esta página es la fuente de verdad visual.
				</p>
			</header>

			<!-- ═══════════ 01 · BUTTONS ═══════════ -->
			<section class="space-y-6">
				<header class="flex items-baseline justify-between border-b border-border pb-3">
					<h2 class="text-xl font-bold tracking-tight">Buttons</h2>
					<span class="font-mono text-[10px] uppercase tracking-widest text-muted tabular-nums">01</span>
				</header>

				<!-- Primary -->
				<div class="space-y-3">
					<p class="font-mono text-[10px] uppercase tracking-widest text-muted">// PRIMARY · TEXTO + BORDE ACENTO · HOVER: RELLENO ACENTO + TEXTO COLOR DE FONDO</p>
					<div class="flex flex-wrap items-center gap-3">
						<Button variant="primary" size="sm" href="#">Primary sm</Button>
						<Button variant="primary" size="md" href="#">Primary md</Button>
						<Button variant="primary" size="lg" href="#">Primary lg</Button>
						<Button variant="primary" size="md" href="#" disabled>Disabled</Button>
					</div>
				</div>

				<!-- Secondary -->
				<div class="space-y-3">
					<p class="font-mono text-[10px] uppercase tracking-widest text-muted">// SECONDARY · BORDE QUIET · HOVER ACENTO + FILL WHITE/5</p>
					<div class="flex flex-wrap items-center gap-3">
						<Button variant="secondary" size="sm" href="#">Secondary sm</Button>
						<Button variant="secondary" size="md" href="#">Secondary md</Button>
						<Button variant="secondary" size="lg" href="#">Secondary lg</Button>
						<Button variant="secondary" size="md" href="#" disabled>Disabled</Button>
					</div>
				</div>

				<!-- Link -->
				<div class="space-y-3">
					<p class="font-mono text-[10px] uppercase tracking-widest text-muted">// LINK · TEXTO + FLECHA · HOVER ACENTO</p>
					<div class="flex flex-wrap items-center gap-6">
						<Button variant="link" size="md" href="#">Link normal <span class="text-accent" aria-hidden="true">→</span></Button>
						<Button variant="link" size="md" href="#">Agenda <span class="text-accent" aria-hidden="true">→</span></Button>
						<a href="#" class="inline-flex items-center gap-1.5 text-sm font-medium text-foreground border-b border-foreground/30 hover:border-accent hover:text-accent transition-colors pb-0.5">Underlined</a>
						<Button variant="link" size="md" href="#" disabled>Link disabled</Button>
					</div>
				</div>
			</section>

			<!-- ═══════════ 02 · TYPOGRAPHY ═══════════ -->
			<section class="space-y-6">
				<header class="flex items-baseline justify-between border-b border-border pb-3">
					<h2 class="text-xl font-bold tracking-tight">Typography</h2>
					<span class="font-mono text-[10px] uppercase tracking-widest text-muted tabular-nums">02</span>
				</header>

				<div class="space-y-4">
					<p class="font-mono text-[10px] uppercase tracking-widest text-muted">// DISPLAY · H1 · USADO EN HERO</p>
					<p class="text-[clamp(2.75rem,6.5vw,4.5rem)] font-bold leading-[0.95]">Arturo Jofré López</p>
				</div>
				<div class="space-y-2">
					<p class="font-mono text-[10px] uppercase tracking-widest text-muted">// HEADLINE · H2 · SECCIONES</p>
					<p class="text-[clamp(1.875rem,3.5vw,2.5rem)] font-bold leading-[1.1]">Últimos proyectos</p>
				</div>
				<div class="space-y-2">
					<p class="font-mono text-[10px] uppercase tracking-widest text-muted">// TITLE · H3 · CARDS / PROJECT CARDS</p>
					<p class="text-base font-bold">Nuevo sitio Autofin</p>
				</div>
				<div class="space-y-2">
					<p class="font-mono text-[10px] uppercase tracking-widest text-muted">// BODY · TEXTO LARGO</p>
					<p class="text-base leading-[1.65] text-muted text-pretty max-w-2xl">14 años diseñando productos digitales para gobierno, salud, finanzas, retail y logística. Cada proyecto llevado desde la investigación hasta el lanzamiento.</p>
				</div>
				<div class="space-y-3">
					<p class="font-mono text-[10px] uppercase tracking-widest text-muted">// KICKER · COMPONENTE · TONO ACENTO / MUTED / FOREGROUND</p>
					<div class="flex flex-col gap-1">
						<Kicker>35+ PROYECTOS // 8 INDUSTRIAS</Kicker>
						<Kicker tone="muted">SEP 2011 — PRESENTE // 7 ROLES</Kicker>
						<Kicker tone="foreground">DISCIPLINAS // RESEARCH — DESIGN</Kicker>
					</div>
				</div>
				<div class="space-y-2">
					<p class="font-mono text-[10px] uppercase tracking-widest text-muted">// MICROCOPY · STATUS / TELEMETRY</p>
					<MonoMicrocopy>// STATUS: AVAILABLE · REPLY &lt; 24H · SANTIAGO, CL</MonoMicrocopy>
					<MonoMicrocopy tone="accent">// SYSTEM // ONLINE · v0.2 · three · webgl</MonoMicrocopy>
				</div>
			</section>

			<!-- ═══════════ 03 · FORM CONTROLS ═══════════ -->
			<section class="space-y-6">
				<header class="flex items-baseline justify-between border-b border-border pb-3">
					<h2 class="text-xl font-bold tracking-tight">Form controls</h2>
					<span class="font-mono text-[10px] uppercase tracking-widest text-muted tabular-nums">03</span>
				</header>

				<div class="grid md:grid-cols-2 gap-8">
					<div class="space-y-3">
						<p class="font-mono text-[10px] uppercase tracking-widest text-muted">// TEXT INPUT</p>
						<div class="space-y-1.5">
							<label class="font-mono text-[10px] uppercase tracking-widest text-muted">Nombre</label>
							<input type="text" placeholder="Arturo Jofré" class="w-full bg-transparent border border-border px-3 py-2 text-sm text-foreground placeholder:text-muted/50 focus:border-accent focus:outline-none transition-colors" />
						</div>
						<div class="space-y-1.5">
							<label class="font-mono text-[10px] uppercase tracking-widest text-muted">Email</label>
							<input type="email" placeholder="hola@arturojofre.cl" class="w-full bg-transparent border border-border px-3 py-2 text-sm text-foreground placeholder:text-muted/50 focus:border-accent focus:outline-none transition-colors" />
							<p class="font-mono text-[10px] uppercase tracking-widest text-muted">// FORMATO: nombre@dominio.cl</p>
						</div>
						<div class="space-y-1.5">
							<label class="font-mono text-[10px] uppercase tracking-widest text-muted">Proyecto</label>
							<input type="text" value="Autofin" disabled class="w-full bg-white/[0.03] border border-border px-3 py-2 text-sm text-muted focus:border-accent focus:outline-none transition-colors" />
						</div>
					</div>

					<div class="space-y-3">
						<p class="font-mono text-[10px] uppercase tracking-widest text-muted">// TEXTAREA</p>
						<textarea rows="3" placeholder="Cuéntame sobre tu proyecto…" class="w-full bg-transparent border border-border px-3 py-2 text-sm text-foreground placeholder:text-muted/50 focus:border-accent focus:outline-none transition-colors resize-y"></textarea>

						<p class="font-mono text-[10px] uppercase tracking-widest text-muted pt-4">// SELECT</p>
						<select class="w-full bg-transparent border border-border px-3 py-2 text-sm text-foreground focus:border-accent focus:outline-none transition-colors">
							<option class="bg-background">Gobierno</option>
							<option class="bg-background">Salud</option>
							<option class="bg-background">Finanzas</option>
							<option class="bg-background">Retail</option>
						</select>
					</div>
				</div>

				<!-- Checkbox / radio / toggle / range -->
				<div class="grid md:grid-cols-2 gap-8">
					<div class="space-y-3">
						<p class="font-mono text-[10px] uppercase tracking-widest text-muted">// CHECKBOX & RADIO</p>
						<div class="flex items-center gap-2">
							<input type="checkbox" checked class="h-4 w-4 accent-accent bg-transparent border border-border rounded-none" />
							<label class="text-sm text-foreground">Gobierno</label>
						</div>
						<div class="flex items-center gap-2">
							<input type="checkbox" class="h-4 w-4 accent-accent bg-transparent border border-border rounded-none" />
							<label class="text-sm text-foreground">Finanzas</label>
						</div>
						<div class="flex items-center gap-2 pt-2">
							<input type="radio" name="sector" checked class="h-4 w-4 accent-accent bg-transparent border border-border" />
							<label class="text-sm text-foreground">UX</label>
						</div>
						<div class="flex items-center gap-2">
							<input type="radio" name="sector" class="h-4 w-4 accent-accent bg-transparent border border-border" />
							<label class="text-sm text-foreground">DEV</label>
						</div>
					</div>

					<div class="space-y-4">
						<p class="font-mono text-[10px] uppercase tracking-widest text-muted">// TOGGLE SWITCH</p>
						<label class="inline-flex items-center gap-3 cursor-pointer group">
							<input type="checkbox" checked class="peer sr-only" />
							<span class="relative w-10 h-5 border border-border peer-checked:border-accent bg-transparent transition-colors">
								<span class="absolute top-0.5 left-0.5 h-3 w-3 bg-muted peer-checked:bg-accent peer-checked:translate-x-5 transition-all"></span>
							</span>
							<span class="text-sm text-foreground">Auto-rotate</span>
						</label>

						<p class="font-mono text-[10px] uppercase tracking-widest text-muted pt-2">// RANGE</p>
						<input type="range" min="0" max="2" step="0.05" value="1" class="w-48 accent-accent" />
						<div class="flex justify-between w-48 font-mono text-[10px] uppercase tracking-widest text-muted">
							<span>MIN</span>
							<span class="text-foreground tabular-nums">1.00</span>
							<span>MAX</span>
						</div>
					</div>
				</div>
			</section>

			<!-- ═══════════ 04 · BADGES & STATUS ═══════════ -->
			<section class="space-y-6">
				<header class="flex items-baseline justify-between border-b border-border pb-3">
					<h2 class="text-xl font-bold tracking-tight">Badges & status</h2>
					<span class="font-mono text-[10px] uppercase tracking-widest text-muted tabular-nums">04</span>
				</header>

				<p class="font-mono text-[10px] uppercase tracking-widest text-muted">// STATUS · PULSO ANIMADO · A11Y: ROLE="STATUS" + ARIA-LIVE="POLITE"</p>
				<div class="flex flex-wrap items-center gap-3">
					<Badge variant="status" role="status" aria-live="polite">
						Disponible para proyectos
					</Badge>
					<Badge variant="online">Online</Badge>
				</div>

				<p class="font-mono text-[10px] uppercase tracking-widest text-muted pt-4">// TAG · LABEL METADATA</p>
				<div class="flex flex-wrap items-center gap-3">
					<Badge variant="tag">TAG · UX</Badge>
					<Badge variant="tag">TAG · RESEARCH</Badge>
				</div>

				<p class="font-mono text-[10px] uppercase tracking-widest text-muted pt-4">// COUNT · NÚMERO DESTACADO / QUIET</p>
				<div class="flex flex-wrap items-center gap-3">
					<Badge variant="count" class="bg-accent text-white">3</Badge>
					<Badge variant="count" class="border border-border text-muted">12</Badge>
				</div>
			</section>

			<!-- ═══════════ 05 · CARDS ═══════════ -->
			<section class="space-y-6">
				<header class="flex items-baseline justify-between border-b border-border pb-3">
					<h2 class="text-xl font-bold tracking-tight">Cards</h2>
					<span class="font-mono text-[10px] uppercase tracking-widest text-muted tabular-nums">05</span>
				</header>

				<div class="grid sm:grid-cols-3 gap-3">
					<a href="#" class="group block bg-background border border-border hover:border-accent transition-colors">
						<div class="aspect-[3/2] bg-white/5 overflow-hidden relative">
							<img src="/assets/img/portafolio/thumbs/autofin-web.png" alt="" loading="lazy" decoding="async" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 ease-out" />
						</div>
						<div class="p-4 border-t border-border">
							<div class="flex items-baseline justify-between mb-1.5">
								<h3 class="text-sm font-bold group-hover:text-accent transition-colors">Nuevo sitio Autofin</h3>
								<span class="font-mono text-[10px] uppercase tracking-widest text-muted tabular-nums ml-2">2019</span>
							</div>
							<p class="text-xs text-muted leading-relaxed line-clamp-2">Rediseño y un nuevo simulador de crédito automotriz.</p>
						</div>
					</a>
					<div class="border border-border p-5 bg-background">
						<p class="font-mono text-[10px] uppercase tracking-widest text-accent mb-2">[ META // CARD ]</p>
						<h3 class="text-base font-bold mb-1.5">Card simple</h3>
						<p class="text-sm text-muted leading-relaxed">Para bloques de contenido que no son navegables. Sin hover, sin escala, borde quiet.</p>
					</div>
					<div class="border border-border p-5 bg-white/[0.02]">
						<p class="font-mono text-[10px] uppercase tracking-widest text-muted mb-2">[ HIGHLIGHT ]</p>
						<h3 class="text-base font-bold mb-1.5">Card raised</h3>
						<p class="text-sm text-muted leading-relaxed">Uso puntual para destacar. Fondo white/2 en vez de shadow — flat by default.</p>
					</div>
				</div>
			</section>

			<!-- ═══════════ 06 · DATA ═══════════ -->
			<section class="space-y-6">
				<header class="flex items-baseline justify-between border-b border-border pb-3">
					<h2 class="text-xl font-bold tracking-tight">Data readouts</h2>
					<span class="font-mono text-[10px] uppercase tracking-widest text-muted tabular-nums">06</span>
				</header>

				<div class="grid md:grid-cols-2 gap-8">
					<div class="space-y-2">
						<p class="font-mono text-[10px] uppercase tracking-widest text-muted">// HUD READOUT · FRAMED (SectionFrame + Kicker)</p>
						<HudReadout
							rows={hudRows}
							label="Trayectoria profesional"
							framed
						/>
					</div>

					<div class="space-y-2">
						<p class="font-mono text-[10px] uppercase tracking-widest text-muted">// HUD READOUT · BARE (SIN FRAME, PARA INLINE)</p>
						<HudReadout
							rows={hudRows}
							label="Trayectoria profesional"
						/>
					</div>
				</div>

				<div class="space-y-2">
					<p class="font-mono text-[10px] uppercase tracking-widest text-muted">// TABLE</p>
					<table class="w-full font-mono text-[10px] uppercase tracking-widest border-collapse">
						<thead>
							<tr class="border-b border-border">
								<th class="text-left text-muted font-normal py-2 pr-4">CLIENTE</th>
								<th class="text-left text-muted font-normal py-2 pr-4">ROL</th>
								<th class="text-right text-muted font-normal py-2 tabular-nums">AÑO</th>
							</tr>
						</thead>
						<tbody>
							<tr class="border-b border-border/40 hover:bg-white/[0.02]">
								<td class="py-2 pr-4 text-foreground">Cleverit</td>
								<td class="py-2 pr-4 text-muted">Senior UX</td>
								<td class="py-2 text-right text-muted tabular-nums">2022</td>
							</tr>
							<tr class="border-b border-border/40 hover:bg-white/[0.02]">
								<td class="py-2 pr-4 text-foreground">Aureolab</td>
								<td class="py-2 pr-4 text-muted">Lead UX</td>
								<td class="py-2 text-right text-muted tabular-nums">2020</td>
							</tr>
							<tr class="hover:bg-white/[0.02]">
								<td class="py-2 pr-4 text-foreground">Pávlov</td>
								<td class="py-2 pr-4 text-muted">Co-founder</td>
								<td class="py-2 text-right text-muted tabular-nums">2015</td>
							</tr>
						</tbody>
					</table>
				</div>
			</section>

			<!-- ═══════════ 07 · NAVIGATION ═══════════ -->
			<section class="space-y-6">
				<header class="flex items-baseline justify-between border-b border-border pb-3">
					<h2 class="text-xl font-bold tracking-tight">Navigation</h2>
					<span class="font-mono text-[10px] uppercase tracking-widest text-muted tabular-nums">07</span>
				</header>

				<div class="space-y-2">
					<p class="font-mono text-[10px] uppercase tracking-widest text-muted">// TABS</p>
					<div class="inline-flex border border-border divide-x divide-border">
						<button class="px-4 py-2 font-mono text-[10px] uppercase tracking-widest text-accent bg-white/5">Todos</button>
						<button class="px-4 py-2 font-mono text-[10px] uppercase tracking-widest text-muted hover:text-foreground transition-colors">UX</button>
						<button class="px-4 py-2 font-mono text-[10px] uppercase tracking-widest text-muted hover:text-foreground transition-colors">DEV</button>
						<button class="px-4 py-2 font-mono text-[10px] uppercase tracking-widest text-muted hover:text-foreground transition-colors">Brand</button>
					</div>
				</div>

				<div class="space-y-2">
					<p class="font-mono text-[10px] uppercase tracking-widest text-muted">// BREADCRUMB</p>
					<nav class="flex items-center gap-2 font-mono text-[10px] uppercase tracking-widest text-muted">
						<a href="#" class="hover:text-foreground transition-colors">Inicio</a>
						<span>/</span>
						<a href="#" class="hover:text-foreground transition-colors">Proyectos</a>
						<span>/</span>
						<span class="text-foreground">Autofin</span>
					</nav>
				</div>

				<div class="space-y-2">
					<p class="font-mono text-[10px] uppercase tracking-widest text-muted">// PAGINATION</p>
					<div class="inline-flex border border-border divide-x divide-border font-mono text-[10px] uppercase tracking-widest">
						<a href="#" class="px-3 py-2 text-muted hover:text-foreground transition-colors">‹</a>
						<a href="#" class="px-3 py-2 text-accent bg-white/5">1</a>
						<a href="#" class="px-3 py-2 text-muted hover:text-foreground transition-colors">2</a>
						<a href="#" class="px-3 py-2 text-muted hover:text-foreground transition-colors">3</a>
						<a href="#" class="px-3 py-2 text-muted hover:text-foreground transition-colors">›</a>
					</div>
				</div>
			</section>

			<!-- ═══════════ 08 · FEEDBACK ═══════════ -->
			<section class="space-y-6">
				<header class="flex items-baseline justify-between border-b border-border pb-3">
					<h2 class="text-xl font-bold tracking-tight">Feedback</h2>
					<span class="font-mono text-[10px] uppercase tracking-widest text-muted tabular-nums">08</span>
				</header>

				<div class="space-y-3">
					<p class="font-mono text-[10px] uppercase tracking-widest text-muted">// ALERTS · INFO / NOTA / ERROR</p>
					<Alert variant="info">
						Disponible para nuevos proyectos desde agosto 2026.
					</Alert>
					<Alert variant="note">
						Algunos proyectos antiguos no están publicados por confidencialidad.
					</Alert>
					<Alert variant="error">
						No se pudo cargar el proyecto. Intenta de nuevo.
					</Alert>
				</div>

				<div class="grid md:grid-cols-2 gap-8">
					<div class="space-y-2">
						<p class="font-mono text-[10px] uppercase tracking-widest text-muted">// EMPTY STATE</p>
						<div class="border border-dashed border-border p-8 text-center">
							<p class="font-mono text-[10px] uppercase tracking-widest text-accent mb-2">[ 0 RESULTS ]</p>
							<p class="text-sm text-muted">No hay proyectos en esta categoría todavía.</p>
						</div>
					</div>
					<div class="space-y-2">
						<p class="font-mono text-[10px] uppercase tracking-widest text-muted">// LOADING</p>
						<div class="flex items-center gap-3 border border-border p-8">
							<span class="w-4 h-4 border border-accent border-t-transparent animate-spin"></span>
							<p class="font-mono text-[10px] uppercase tracking-widest text-muted">// CARGANDO</p>
						</div>
					</div>
				</div>
			</section>

			<!-- ═══════════ 09 · FRAMES & DIVIDERS ═══════════ -->
			<section class="space-y-6">
				<header class="flex items-baseline justify-between border-b border-border pb-3">
					<h2 class="text-xl font-bold tracking-tight">Frames & dividers</h2>
					<span class="font-mono text-[10px] uppercase tracking-widest text-muted tabular-nums">09</span>
				</header>

				<div class="space-y-2">
					<p class="font-mono text-[10px] uppercase tracking-widest text-muted">// SECTION FRAME · VARIANTES DE TONO</p>

					<p class="font-mono text-[10px] uppercase tracking-widest text-muted">— ACENTO (HERO/CV)</p>
					<SectionFrame tone="accent" class="border border-accent/40 p-5">
