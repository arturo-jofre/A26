---
interface Props {
	tone?: "muted" | "accent";
	class?: string;
}
const { tone = "muted", class: className = "" } = Astro.props;
const toneClass = {
	muted: "text-muted",
	accent: "text-accent",
}[tone];
---

<p
	class:list={[
		"font-mono text-[0.6875rem] uppercase tracking-widest leading-relaxed",
		toneClass,
		className,
	]}
>
	<slot />
</p>
