---
interface Props {
  variant?: "info" | "note" | "error";
  label?: string;
  class?: string;
}
const {
  variant = "info",
  label,
  class: className = "",
} = Astro.props;

const variantClasses = {
  info: "border-accent/40",
  note: "border-border",
  error: "border-red-400/40",
} as const;

const labelClasses = {
  info: "text-accent",
  note: "text-muted",
  error: "text-red-400",
} as const;

const defaultLabels = {
  info: "[ INFO ]",
  note: "[ NOTA ]",
  error: "[ ERROR ]",
} as const;
---

<div class:list={["border p-4", variantClasses[variant], className]}>
  <p
    class:list={[
      "font-mono text-[0.625rem] uppercase tracking-widest mb-1.5",
      labelClasses[variant],
    ]}
  >
    {label ?? defaultLabels[variant]}
  </p>
  <p class="text-sm text-foreground leading-relaxed">
    <slot />
  </p>
</div>
