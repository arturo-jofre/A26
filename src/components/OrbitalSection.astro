---
import Kicker from "./Kicker.astro";
---

<section id="orbital" class="relative py-24">
	<div class="mx-auto max-w-6xl px-4 sm:px-8 lg:px-12">
		<div class="mb-8 space-y-2">
			<Kicker>PRACTICE AREAS // UX · DEV · BUSINESS</Kicker>
			<h2 class="text-2xl font-bold tracking-tight">Orbital</h2>
		</div>

		<div
			id="orbital-container"
			class="orbital relative h-[75dvh] bg-white/[0.02] border border-border overflow-hidden isolate"
			role="img"
			aria-label="Three practice areas orbiting a center of craft: UX, DEV, BUSINESS."
		>
			<div class="orbital-grid" aria-hidden="true"></div>
			<div class="orbital-dots" aria-hidden="true"></div>

			<div id="orbital-canvas" class="absolute inset-0 z-[1]"></div>

			<div
				id="orbital-static"
				class="absolute inset-0 hidden items-center justify-center z-20"
				aria-hidden="true"
			>
				<div
					class="font-mono text-xs uppercase tracking-widest text-muted flex items-center gap-8"
				>
					<span>UX</span>
					<span class="w-1 h-1 rounded-full bg-muted"></span>
					<span>DEV</span>
					<span class="w-1 h-1 rounded-full bg-muted"></span>
					<span>BUSINESS</span>
				</div>
			</div>

			<div class="orbital-hud" aria-hidden="true">
				<span class="orbital-hud-corner orbital-hud-corner--tl"></span>
				<span class="orbital-hud-corner orbital-hud-corner--tr"></span>
				<span class="orbital-hud-corner orbital-hud-corner--bl"></span>
				<span class="orbital-hud-corner orbital-hud-corner--br"></span>

				<span class="orbital-hud-crosshair">
					<span></span>
					<span></span>
				</span>

				<div class="orbital-hud-panel orbital-hud-panel--tl">
					<Kicker tone="accent" class="mb-1">SYSTEM // ONLINE</Kicker>
					<p class="font-mono text-[10px] uppercase tracking-widest text-muted leading-relaxed">
						v0.2 · three · webgl
					</p>
				</div>

				<div class="orbital-hud-panel orbital-hud-panel--tr text-right">
					<Kicker tone="muted" class="mb-1">SECTOR // 03-A</Kicker>
					<p class="font-mono text-[10px] uppercase tracking-widest text-muted leading-relaxed">
						BAND · K · LOCK
					</p>
				</div>

				<div class="orbital-hud-panel orbital-hud-panel--bl">
					<Kicker tone="muted" class="mb-2">TELEMETRY</Kicker>
					<dl
						id="orbital-readout"
						class="font-mono text-[10px] uppercase tracking-widest grid grid-cols-2 gap-x-4 gap-y-0.5 min-w-[260px] m-0"
					>
						<div class="flex justify-between gap-2">
							<dt class="text-muted">FPS</dt>
							<dd class="text-foreground tabular-nums m-0" data-readout="fps">--</dd>
						</div>
						<div class="flex justify-between gap-2">
							<dt class="text-muted">AZI</dt>
							<dd class="text-foreground tabular-nums m-0" data-readout="azi">000°</dd>
						</div>
						<div class="flex justify-between gap-2">
							<dt class="text-muted">SCAN</dt>
							<dd class="text-foreground tabular-nums m-0" data-readout="time">00:00:00</dd>
						</div>
						<div class="flex justify-between gap-2">
							<dt class="text-muted">ELE</dt>
							<dd class="text-foreground tabular-nums m-0" data-readout="ele">+00.0°</dd>
						</div>
						<div class="flex justify-between gap-2">
							<dt class="text-muted">SATS</dt>
							<dd class="text-foreground tabular-nums m-0" data-readout="sats">03</dd>
						</div>
						<div class="flex justify-between gap-2">
							<dt class="text-muted">RNG</dt>
							<dd class="text-foreground tabular-nums m-0" data-readout="range">0.00</dd>
						</div>
						<div class="flex justify-between gap-2">
							<dt class="text-muted">FOCUS</dt>
							<dd class="text-foreground tabular-nums m-0" data-readout="focus">+0.00 / +0.00</dd>
						</div>
						<div class="flex justify-between gap-2">
							<dt class="text-muted">HDG</dt>
							<dd class="text-foreground tabular-nums m-0" data-readout="hdg">N</dd>
						</div>
					</dl>
				</div>

				<div class="orbital-hud-panel orbital-hud-panel--bc">
					<div
						class="font-mono text-[10px] uppercase tracking-widest flex items-center gap-3"
					>
						<span class="text-muted">SCALE</span>
						<div class="orbital-scale flex items-center">
							<span class="orbital-scale-tick"></span>
							<span class="orbital-scale-line"></span>
							<span class="orbital-scale-tick"></span>
						</div>
						<span class="text-foreground tabular-nums" data-readout="scale">0.00u</span>
					</div>
				</div>

				<div class="orbital-hud-panel orbital-hud-panel--br">
					<Kicker tone="accent" class="mb-3">CONTROLS // MAP</Kicker>
					<div
						class="grid grid-cols-[auto_1fr] gap-x-3 gap-y-2 font-mono text-[10px] uppercase tracking-widest min-w-[230px]"
					>
						<span class="text-muted self-center">CAM</span>
						<label class="orbital-hud-switch">
							<input
								type="checkbox"
								data-config="cameraOrbit"
								checked
							/>
							<span></span>
						</label>

						<span class="text-muted self-center">SPD</span>
						<input
							type="range"
							data-config="cameraOrbitSpeed"
							min="0"
							max="2"
							step="0.05"
							value="1"
							class="orbital-hud-range"
						/>

						<span class="text-muted self-center">PLT</span>
						<label class="orbital-hud-switch">
							<input
								type="checkbox"
								data-config="planetSpin"
								checked
							/>
							<span></span>
						</label>

						<span class="text-muted self-center">RAT</span>
						<input
							type="range"
							data-config="planetSpinSpeed"
							min="0"
							max="2"
							step="0.05"
							value="1"
							class="orbital-hud-range"
						/>

						<span class="text-muted self-center">R-UX</span>
						<input
							type="range"
							data-config="orbitRadius"
							data-index="0"
							min="1.4"
							max="3.2"
							step="0.05"
							value="2.0"
							class="orbital-hud-range"
						/>

						<span class="text-muted self-center">R-DV</span>
						<input
							type="range"
							data-config="orbitRadius"
							data-index="1"
							min="1.4"
							max="3.2"
							step="0.05"
							value="2.2"
							class="orbital-hud-range"
						/>

						<span class="text-muted self-center">R-BZ</span>
						<input
							type="range"
							data-config="orbitRadius"
							data-index="2"
							min="1.4"
							max="3.2"
							step="0.05"
							value="2.4"
							class="orbital-hud-range"
						/>

						<span class="text-muted self-center">SHP</span>
						<div class="flex gap-1">
							<button
								type="button"
								data-config="satelliteShape"
								data-value="triangle"
								class="orbital-hud-btn orbital-hud-btn--active"
								aria-label="Triangle shape">▲</button
							>
							<button
								type="button"
								data-config="satelliteShape"
								data-value="sphere"
								class="orbital-hud-btn"
								aria-label="Sphere shape">●</button
							>
							<button
								type="button"
								data-config="satelliteShape"
								data-value="diamond"
								class="orbital-hud-btn"
								aria-label="Diamond shape">◆</button
							>
						</div>

						<span class="text-muted self-center">SIZ</span>
						<input
							type="range"
							data-config="satelliteSize"
							min="0.08"
							max="0.3"
							step="0.01"
							value="0.12"
							class="orbital-hud-range"
						/>

						<span class="text-muted self-center">GRD</span>
						<div class="flex gap-1">
							<button
								type="button"
								data-config="gridResolution"
								data-value="10"
								class="orbital-hud-btn"
								aria-label="10 degree grid">10°</button
							>
							<button
								type="button"
								data-config="gridResolution"
								data-value="20"
								class="orbital-hud-btn orbital-hud-btn--active"
								aria-label="20 degree grid">20°</button
							>
							<button
								type="button"
								data-config="gridResolution"
								data-value="30"
								class="orbital-hud-btn"
								aria-label="30 degree grid">30°</button
							>
							<button
								type="button"
								data-config="gridResolution"
								data-value="45"
								class="orbital-hud-btn"
								aria-label="45 degree grid">45°</button
							>
						</div>

						<span class="text-muted self-center">COL</span>
						<div class="flex items-center gap-2">
							<input
								type="color"
								data-config="orbitColor"
								value="#8a847c"
								class="orbital-hud-color"
								aria-label="Orbit color"
							/>
							<label class="orbital-hud-switch">
								<input type="checkbox" data-config="dashed" checked />
								<span></span>
							</label>
							<span class="text-muted text-[9px]">DASH</span>
						</div>

						<div class="col-span-2 flex items-center gap-2 pt-1 border-t border-border/40">
							<span class="text-muted text-[9px]">RST</span>
							<button
								type="button"
								data-action="resetCamera"
								class="orbital-hud-btn flex-1"
								aria-label="Reset camera">RESET CAM</button
							>
						</div>
					</div>
				</div>

				<div
					id="orbital-target-sat"
					class="orbital-hud-panel orbital-hud-panel--tc hidden"
				>
					<Kicker tone="accent" class="mb-2">TARGET // LOCKED</Kicker>
					<dl
						class="font-mono text-[10px] uppercase tracking-widest space-y-0.5 min-w-[200px] m-0"
					>
						<div class="flex justify-between gap-3">
							<dt class="text-muted">NAME</dt>
							<dd
								class="text-foreground tabular-nums m-0"
								data-target-sat="name">--</dd
							>
						</div>
						<div class="flex justify-between gap-3">
							<dt class="text-muted">RADIUS</dt>
							<dd
								class="text-foreground tabular-nums m-0"
								data-target-sat="radius">--</dd
							>
						</div>
						<div class="flex justify-between gap-3">
							<dt class="text-muted">INCL</dt>
							<dd
								class="text-foreground tabular-nums m-0"
								data-target-sat="incl">--</dd
							>
						</div>
						<div class="flex justify-between gap-3">
							<dt class="text-muted">SPD</dt>
							<dd
								class="text-foreground tabular-nums m-0"
								data-target-sat="spd">--</dd
							>
						</div>
					</dl>
				</div>

				<div
					id="orbital-target-planet"
					class="orbital-hud-panel orbital-hud-panel--tc hidden"
				>
					<Kicker tone="accent" class="mb-2">PLANET POINT</Kicker>
					<dl
						class="font-mono text-[10px] uppercase tracking-widest space-y-0.5 min-w-[200px] m-0"
					>
						<div class="flex justify-between gap-3">
							<dt class="text-muted">LAT</dt>
							<dd
								class="text-foreground tabular-nums m-0"
								data-target-planet="lat">--</dd
							>
						</div>
						<div class="flex justify-between gap-3">
							<dt class="text-muted">LON</dt>
							<dd
								class="text-foreground tabular-nums m-0"
								data-target-planet="lon">--</dd
							>
						</div>
					</dl>
				</div>
			</div>
		</div>
	</div>
</section>

<style>
	.orbital-label {
		font-family: "Geist Mono", monospace;
		font-size: 0.6rem;
		text-transform: uppercase;
		letter-spacing: 0.15em;
		color: var(--color-accent);
		user-select: none;
		pointer-events: none;
	}

	/* ---------- HUD layer ---------- */
	.orbital-grid {
		position: absolute;
		inset: 0;
		pointer-events: none;
		z-index: 0;
		background-image:
			linear-gradient(
				to right,
				var(--color-muted) 1px,
				transparent 1px
			),
			linear-gradient(
				to bottom,
				var(--color-muted) 1px,
				transparent 1px
			);
		background-size: 80px 80px;
		opacity: 0.12;
		mask-image: radial-gradient(
			ellipse 70% 60% at 50% 50%,
			black 0%,
			black 50%,
			transparent 90%
		);
		-webkit-mask-image: radial-gradient(
			ellipse 70% 60% at 50% 50%,
			black 0%,
			black 50%,
			transparent 90%
		);
	}

	.orbital-dots {
		position: absolute;
		inset: 0;
		pointer-events: none;
		z-index: 0;
		background-image:
			radial-gradient(
				circle,
				var(--color-muted) 1px,
				transparent 1.5px
			),
			radial-gradient(
				circle,
				var(--color-muted) 1.5px,
				transparent 2px
			);
		background-size:
			24px 24px,
			120px 120px;
		opacity: 0.18;
		mask-image: radial-gradient(
			ellipse 70% 60% at 50% 50%,
			black 0%,
			black 50%,
			transparent 90%
		);
		-webkit-mask-image: radial-gradient(
			ellipse 70% 60% at 50% 50%,
			black 0%,
			black 50%,
			transparent 90%
		);
	}

	.orbital-hud {
		position: absolute;
		inset: 0;
		pointer-events: none;
		z-index: 5;
		font-family: "Geist Mono", monospace;
	}

	/* Corner brackets */
	.orbital-hud-corner {
		position: absolute;
		width: 18px;
		height: 18px;
		color: var(--color-accent);
		opacity: 0.85;
	}
	.orbital-hud-corner::before,
	.orbital-hud-corner::after {
		content: "";
		position: absolute;
		background: currentColor;
	}
	.orbital-hud-corner--tl {
		top: 10px;
		left: 10px;
	}
	.orbital-hud-corner--tl::before {
		top: 0;
		left: 0;
		right: 0;
		height: 1px;
	}
	.orbital-hud-corner--tl::after {
		top: 0;
		left: 0;
		bottom: 0;
		width: 1px;
	}
	.orbital-hud-corner--tr {
		top: 10px;
		right: 10px;
	}
	.orbital-hud-corner--tr::before {
		top: 0;
		left: 0;
		right: 0;
		height: 1px;
	}
	.orbital-hud-corner--tr::after {
		top: 0;
		right: 0;
		bottom: 0;
		width: 1px;
	}
	.orbital-hud-corner--bl {
		bottom: 10px;
		left: 10px;
	}
	.orbital-hud-corner--bl::before {
		bottom: 0;
		left: 0;
		right: 0;
		height: 1px;
	}
	.orbital-hud-corner--bl::after {
		bottom: 0;
		left: 0;
		top: 0;
		width: 1px;
	}
	.orbital-hud-corner--br {
		bottom: 10px;
		right: 10px;
	}
	.orbital-hud-corner--br::before {
		bottom: 0;
		left: 0;
		right: 0;
		height: 1px;
	}
	.orbital-hud-corner--br::after {
		bottom: 0;
		right: 0;
		top: 0;
		width: 1px;
	}

	/* Crosshair center */
	.orbital-hud-crosshair {
		position: absolute;
		top: 50%;
		left: 50%;
		width: 0;
		height: 0;
		opacity: 0.45;
	}
	.orbital-hud-crosshair span {
		position: absolute;
		background: var(--color-accent);
	}
	.orbital-hud-crosshair span:first-child {
		width: 12px;
		height: 1px;
		left: -6px;
		top: 0;
	}
	.orbital-hud-crosshair span:last-child {
		width: 1px;
		height: 12px;
		left: 0;
		top: -6px;
	}

	/* HUD panels */
	.orbital-hud-panel {
		position: absolute;
		padding: 0.65rem 0.85rem;
		background: rgba(24, 24, 24, 0.6);
		border: 1px solid var(--color-border-strong);
		backdrop-filter: blur(4px);
		-webkit-backdrop-filter: blur(4px);
		pointer-events: none;
	}
	.orbital-hud-panel--tl {
		top: 28px;
		left: 28px;
	}
	.orbital-hud-panel--tr {
		top: 28px;
		right: 28px;
	}
	.orbital-hud-panel--bl {
		bottom: 28px;
		left: 28px;
	}
	.orbital-hud-panel--br {
		bottom: 28px;
		right: 28px;
	}
	.orbital-hud-panel--bc {
		bottom: 32px;
		left: 50%;
		transform: translateX(-50%);
		padding: 0.45rem 0.85rem;
		pointer-events: none;
	}
	.orbital-hud-panel--tc {
		top: 28px;
		left: 50%;
		transform: translateX(-50%);
		padding: 0.5rem 0.85rem;
		pointer-events: none;
	}

	/* Scale bar visuals */
	.orbital-scale {
		gap: 0;
	}
	.orbital-scale-tick {
		display: block;
		width: 1px;
		height: 10px;
		background: var(--color-foreground);
	}
	.orbital-scale-line {
		display: block;
		width: 64px;
		height: 1px;
		background: var(--color-foreground);
	}

	/* Compass label sizing (overrides default .orbital-label) */
	.orbital-label--cardinal {
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.18em;
	}
	.orbital-label--intercardinal {
		font-size: 0.55rem;
		font-weight: 500;
		letter-spacing: 0.12em;
		opacity: 0.7;
	}

	/* Only the bottom-right control panel catches input;
	   individual controls override below */
	.orbital-hud-panel--br {
		pointer-events: auto;
	}

	/* Scanlines overlay */
	.orbital-hud::after {
		content: "";
		position: absolute;
		inset: 0;
		background: repeating-linear-gradient(
			0deg,
			transparent 0,
			transparent 2px,
			rgba(240, 64, 0, 0.03) 2px,
			rgba(240, 64, 0, 0.03) 3px
		);
		pointer-events: none;
		mix-blend-mode: screen;
	}

	/* Glitch on hover */
	.orbital-hud::before {
		content: "";
		position: absolute;
		inset: 0;
		pointer-events: none;
		opacity: 0;
		transition: opacity 0.15s ease;
		background:
			linear-gradient(
				90deg,
				rgba(240, 64, 0, 0.07) 0%,
				transparent 2%,
				transparent 98%,
				rgba(240, 64, 0, 0.07) 100%
			),
			linear-gradient(0deg, rgba(0, 200, 255, 0.04) 0%, transparent 50%);
	}
	.orbital:hover .orbital-hud::before {
		opacity: 1;
	}

	/* ---------- Controls ---------- */
	.orbital-hud-panel--br input,
	.orbital-hud-panel--br button,
	.orbital-hud-panel--br select,
	.orbital-hud-panel--br label.orbital-hud-switch {
		pointer-events: auto;
	}

	.orbital-hud-range {
		-webkit-appearance: none;
		appearance: none;
		width: 100%;
		height: 2px;
		background: var(--color-border-strong);
		border: none;
		outline: none;
		cursor: pointer;
		margin: 0;
	}
	.orbital-hud-range::-webkit-slider-thumb {
		-webkit-appearance: none;
		appearance: none;
		width: 10px;
		height: 14px;
		background: var(--color-accent);
		border: 0;
		cursor: grab;
		border-radius: 0;
	}
	.orbital-hud-range::-moz-range-thumb {
		width: 10px;
		height: 14px;
		background: var(--color-accent);
		border: 0;
		border-radius: 0;
		cursor: grab;
	}
	.orbital-hud-range::-webkit-slider-thumb:active {
		cursor: grabbing;
	}

	.orbital-hud-btn {
		flex: 1;
		padding: 0.25rem 0.4rem;
		background: transparent;
		border: 1px solid var(--color-border-strong);
		color: var(--color-muted);
		font-family: "Geist Mono", monospace;
		font-size: 10px;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		cursor: pointer;
		transition:
			color 0.1s,
			border-color 0.1s,
			background 0.1s;
		line-height: 1;
	}
	.orbital-hud-btn:hover {
		color: var(--color-foreground);
		border-color: var(--color-accent);
	}
	.orbital-hud-btn--active {
		color: var(--color-accent);
		border-color: var(--color-accent);
		background: rgba(240, 64, 0, 0.1);
	}

	.orbital-hud-color {
		-webkit-appearance: none;
		appearance: none;
		width: 32px;
		height: 18px;
		background: transparent;
		border: 1px solid var(--color-border-strong);
		cursor: pointer;
		padding: 1px;
		border-radius: 0;
	}
	.orbital-hud-color::-webkit-color-swatch-wrapper {
