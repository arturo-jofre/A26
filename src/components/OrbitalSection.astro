</style>

<script>
	import * as THREE from "three";
	import { OrbitControls } from "three/addons/controls/OrbitControls.js";
	import {
		CSS2DRenderer,
		CSS2DObject,
	} from "three/addons/renderers/CSS2DRenderer.js";

	const prefersReducedMotion = window.matchMedia(
		"(prefers-reduced-motion: reduce)"
	).matches;

	// === Scene refs ===
	let scene: THREE.Scene;
	let camera: THREE.PerspectiveCamera;
	let renderer: THREE.WebGLRenderer;
	let labelRenderer: CSS2DRenderer;
	let controls: OrbitControls;
	let animationId: number;
	let orbitalGroup: THREE.Group;
	let planetGroup: THREE.Group;
	let starfield: THREE.Points | null = null;
	let compass: THREE.Group | null = null;
	let cameraRay: THREE.Line | null = null;
	let satelliteMaterial: THREE.MeshBasicMaterial;
	let interactionTimeout: ReturnType<typeof setTimeout>;
	let canvasHeight = 0;

	// === Interaction state ===
	const raycaster = new THREE.Raycaster();
	const pointer = new THREE.Vector2();
	let hoveredSatellite: Satellite | null = null;
	let selectedSatellite: Satellite | null = null;
	let planetMarker: THREE.Sprite | null = null;
	let planetMarkerLat: number | null = null;
	let planetMarkerLon: number | null = null;
	let reticleTexture: THREE.CanvasTexture | null = null;
	let pointerDownInfo: { x: number; y: number; time: number } | null = null;
	let cameraResetAnim: {
		startPos: THREE.Vector3;
		endPos: THREE.Vector3;
		startTime: number;
		duration: number;
	} | null = null;
	let lastFrameTime = 0;

	// === Readout state ===
	let fpsFrames = 0;
	let fpsLastUpdate = performance.now();
	let scanStart = performance.now();
	let lastReadoutUpdate = 0;
	const readoutEls: Record<string, HTMLElement | null> = {};

	// === Config ===
	type SatelliteShape = "triangle" | "sphere" | "diamond";
	type GridResolution = 10 | 20 | 30 | 45;

	interface Config {
		cameraOrbit: boolean;
		cameraOrbitSpeed: number;
		planetSpin: boolean;
		planetSpinSpeed: number;
		gridResolution: GridResolution;
		satelliteShape: SatelliteShape;
		satelliteSize: number;
		orbitRadii: [number, number, number];
		orbitColor: number;
		dashed: boolean;
	}

	const config: Config = {
		cameraOrbit: true,
		cameraOrbitSpeed: 1.0,
		planetSpin: true,
		planetSpinSpeed: 1.0,
		gridResolution: 20,
		satelliteShape: "triangle",
		satelliteSize: 0.12,
		orbitRadii: [2.0, 2.2, 2.4],
		orbitColor: 0x8a847c,
		dashed: true,
	};

	// === Structural satellite data (not affected by config) ===
	const satelliteData = [
		{
			name: "UX",
			inclination: 0.4,
			azimut: 0,
			orbitSpeed: 0.25,
			satSpeed: 0.3,
		},
		{
			name: "DEV",
			inclination: -0.3,
			azimut: Math.PI / 3,
			orbitSpeed: 0.15,
			satSpeed: 0.5,
		},
		{
			name: "BUSINESS",
			inclination: 0.55,
			azimut: -Math.PI / 5,
			orbitSpeed: 0.35,
			satSpeed: 0.2,
		},
	];

	interface Satellite {
		mesh: THREE.Mesh;
		orbitGroup: THREE.Group;
		orbitLine: THREE.LineLoop;
		orbitLineMaterial: THREE.LineBasicMaterial | THREE.LineDashedMaterial;
		orbitSpeed: number;
		satSpeed: number;
		angle: number;
		radius: number;
		dataIndex: number;
	}

	let satellites: Satellite[] = [];

	// Tracks the dashed state of the planet grid at the time of the last build,
	// so applyConfig can avoid rebuilding when the toggle hasn't changed.
	let lastGridDashed = config.dashed;

	// === Helpers ===

	function createCircleGeometry(
		radius: number,
		segments = 128,
	): THREE.BufferGeometry {
		const points: THREE.Vector3[] = [];
		for (let i = 0; i <= segments; i++) {
			const theta = (i / segments) * Math.PI * 2;
			points.push(
				new THREE.Vector3(
					Math.cos(theta) * radius,
					0,
					Math.sin(theta) * radius,
				),
			);
		}
		return new THREE.BufferGeometry().setFromPoints(points);
	}

	function createParallelGeometry(
		radius: number,
		latitudeDeg: number,
		segments = 96,
	): THREE.BufferGeometry {
		const lat = (latitudeDeg * Math.PI) / 180;
		const y = Math.sin(lat) * radius;
		const r = Math.cos(lat) * radius;
		const points: THREE.Vector3[] = [];
		for (let i = 0; i <= segments; i++) {
			const theta = (i / segments) * Math.PI * 2;
			points.push(
				new THREE.Vector3(Math.cos(theta) * r, y, Math.sin(theta) * r),
			);
		}
		return new THREE.BufferGeometry().setFromPoints(points);
	}

	function createMeridianGeometry(
		radius: number,
		longitudeDeg: number,
		segments = 96,
	): THREE.BufferGeometry {
		// True great circle through both poles at the given longitude.
		// Convention: longitude 0° = +Z, 90° = +X, 180° = -Z, 270° = -X.
		const phi = (longitudeDeg * Math.PI) / 180;
		const points: THREE.Vector3[] = [];
		for (let i = 0; i <= segments; i++) {
			const theta = (i / segments) * Math.PI * 2;
			points.push(
				new THREE.Vector3(
					radius * Math.cos(theta) * Math.sin(phi),
					radius * Math.sin(theta),
					radius * Math.cos(theta) * Math.cos(phi),
				),
			);
		}
		return new THREE.BufferGeometry().setFromPoints(points);
	}

	function buildSatelliteGeometry(
		shape: SatelliteShape,
		size: number,
	): THREE.BufferGeometry {
		// All flat shapes live in the XY plane (z=0) so they sit face-on to
		// the camera when the mesh is oriented via lookAt(camera.position).
		// lookAt aligns local -Z with the camera direction, so any shape in
		// the YZ plane would be edge-on and effectively invisible.
		if (shape === "triangle") {
			// Dart pointing up (+Y) in the XY plane
			const s = size;
			const vertices = new Float32Array([
				0, s, 0, // tip up
				-s * 0.6, -s * 0.5, 0, // back-left
				s * 0.6, -s * 0.5, 0, // back-right
			]);
			const geometry = new THREE.BufferGeometry();
			geometry.setAttribute(
				"position",
				new THREE.BufferAttribute(vertices, 3),
			);
			geometry.setIndex([0, 1, 2, 0, 2, 1]);
			geometry.computeVertexNormals();
			return geometry;
		}
		if (shape === "diamond") {
			// Flat diamond in the XY plane: top / right / bottom / left
			const s = size;
			const vertices = new Float32Array([
				0, s, 0, // top
				s, 0, 0, // right
				0, -s, 0, // bottom
				-s, 0, 0, // left
			]);
			const geometry = new THREE.BufferGeometry();
			geometry.setAttribute(
				"position",
				new THREE.BufferAttribute(vertices, 3),
			);
			// Two triangles: top-right-bottom and top-bottom-left
			geometry.setIndex([0, 1, 2, 0, 2, 3]);
			geometry.computeVertexNormals();
			return geometry;
		}
		return new THREE.SphereGeometry(size, 12, 12);
	}

	function createOrbitMaterial(
		color: number,
		dashed: boolean,
	): THREE.LineBasicMaterial | THREE.LineDashedMaterial {
		if (dashed) {
			return new THREE.LineDashedMaterial({
				color,
				transparent: true,
				opacity: 0.55,
				dashSize: 0.08,
				gapSize: 0.05,
			});
		}
		return new THREE.LineBasicMaterial({
			color,
			transparent: true,
			opacity: 0.4,
		});
	}

	function buildStarfield(count: number): THREE.Points {
		const positions = new Float32Array(count * 3);
		for (let i = 0; i < count; i++) {
			positions[i * 3] = (Math.random() - 0.5) * 50;
			positions[i * 3 + 1] = (Math.random() - 0.5) * 30;
			positions[i * 3 + 2] = -15 - Math.random() * 5;
		}
		const geometry = new THREE.BufferGeometry();
		geometry.setAttribute(
			"position",
			new THREE.BufferAttribute(positions, 3),
		);
		const material = new THREE.PointsMaterial({
			color: 0x8a847c,
			size: 0.04,
			sizeAttenuation: true,
			transparent: true,
			opacity: 0.6,
		});
		return new THREE.Points(geometry, material);
	}

	function buildCompass(): void {
		// Apple Watch Ultra–style compass: flat ring around the planet
		// at the equator (XZ plane), 12 tick marks, cardinal & intercardinal
		// labels. World-fixed — does not rotate with orbitalGroup.
		compass = new THREE.Group();
		const ringRadius = 1.15;
		const tickInner = 1.06;
		const tickOuter = 1.15;
		const cardinalR = 1.3;
		const intercardinalR = 1.22;

		// Main ring
		const ringGeom = new THREE.TorusGeometry(ringRadius, 0.008, 8, 96);
		const ringMat = new THREE.MeshBasicMaterial({
			color: 0x8a847c,
			transparent: true,
			opacity: 0.55,
		});
		const ring = new THREE.Mesh(ringGeom, ringMat);
		ring.rotation.x = Math.PI / 2;
		compass.add(ring);

		// Tick marks every 30°
		const tickMat = new THREE.LineBasicMaterial({
			color: 0x8a847c,
			transparent: true,
			opacity: 0.7,
		});
		for (let deg = 0; deg < 360; deg += 30) {
			const rad = (deg * Math.PI) / 180;
			const inner = new THREE.Vector3(
				Math.sin(rad) * tickInner,
				0,
				Math.cos(rad) * tickInner,
			);
			const outer = new THREE.Vector3(
				Math.sin(rad) * tickOuter,
				0,
				Math.cos(rad) * tickOuter,
			);
			const tickGeom = new THREE.BufferGeometry().setFromPoints([
				inner,
				outer,
			]);
			compass.add(new THREE.Line(tickGeom, tickMat));
		}

		// Labels (CSS2D)
		const mkLabel = (
			text: string,
			angleDeg: number,
			radius: number,
			color: string,
			emphasis: "cardinal" | "intercardinal",
		) => {
			const rad = (angleDeg * Math.PI) / 180;
			const div = document.createElement("div");
			div.className =
				emphasis === "cardinal"
					? "orbital-label orbital-label--cardinal"
					: "orbital-label orbital-label--intercardinal";
			div.textContent = text;
			div.style.color = color;
			const label = new CSS2DObject(div);
			label.position.set(Math.sin(rad) * radius, 0, Math.cos(rad) * radius);
			return label;
		};

		// Cardinals (N in accent)
		compass.add(mkLabel("N", 0, cardinalR, "#f04000", "cardinal"));
		compass.add(mkLabel("E", 90, cardinalR, "#d6d3ce", "cardinal"));
		compass.add(mkLabel("S", 180, cardinalR, "#d6d3ce", "cardinal"));
		compass.add(mkLabel("W", 270, cardinalR, "#d6d3ce", "cardinal"));

		// Intercardinals (smaller, muted)
		compass.add(mkLabel("NE", 45, intercardinalR, "#8a847c", "intercardinal"));
		compass.add(mkLabel("SE", 135, intercardinalR, "#8a847c", "intercardinal"));
		compass.add(mkLabel("SW", 225, intercardinalR, "#8a847c", "intercardinal"));
		compass.add(mkLabel("NW", 315, intercardinalR, "#8a847c", "intercardinal"));

		scene.add(compass);

		// Camera position ray: line from origin to the camera.
		// Endpoint sits at the camera (clipped by near plane) — gives the
		// user a visual "where am I looking from" reference and crosses
		// the compass ring at the user's cardinal bearing.
		const rayGeom = new THREE.BufferGeometry();
		rayGeom.setAttribute(
			"position",
			new THREE.BufferAttribute(new Float32Array(6), 3),
		);
		cameraRay = new THREE.Line(
			rayGeom,
			new THREE.LineBasicMaterial({
				color: 0xf04000,
				transparent: true,
				opacity: 0.55,
			}),
		);
		scene.add(cameraRay);
	}

	function disposeObject(obj: THREE.Object3D): void {
		obj.traverse((child) => {
			const m = child as THREE.Object3D & {
				geometry?: THREE.BufferGeometry;
				material?: THREE.Material | THREE.Material[];
			};
			if (m.geometry) m.geometry.dispose();
			if (m.material) {
				if (Array.isArray(m.material)) {
					m.material.forEach((mm) => mm.dispose());
				} else {
					m.material.dispose();
				}
			}
		});
	}

	function buildPlanetGrid(): void {
		// Clear and dispose old children
		const toRemove = [...planetGroup.children];
		for (const child of toRemove) {
			planetGroup.remove(child);
			disposeObject(child);
		}

		const dashed = config.dashed;
		const r = 0.8;
		const step = config.gridResolution;

		// Three materials: meridians (subtler), parallels (more visible),
		// equator (accent — the primary reference line).
		const mkLineMat = (
			color: number,
			opacity: number,
		): THREE.LineBasicMaterial | THREE.LineDashedMaterial =>
			(dashed
				? new THREE.LineDashedMaterial({
						color,
						transparent: true,
						opacity,
						dashSize: 0.05,
						gapSize: 0.03,
					})
				: new THREE.LineBasicMaterial({
						color,
						transparent: true,
						opacity,
					})) as THREE.LineBasicMaterial | THREE.LineDashedMaterial;

		const meridianMat = mkLineMat(0xd6d3ce, 0.4);
		const parallelMat = mkLineMat(0xd6d3ce, 0.6);
		const equatorMat = mkLineMat(0xf04000, 0.75);

		// Meridians — true great circles through both poles
		for (let lon = 0; lon < 360; lon += step) {
			const line = new THREE.LineLoop(
				createMeridianGeometry(r, lon),
				meridianMat,
			);
			if (dashed) line.computeLineDistances();
			planetGroup.add(line);
		}

		// Parallels — horizontal circles at constant latitude
		for (let lat = -80; lat <= 80; lat += step) {
			const isEquator = lat === 0;
			const mat = isEquator ? equatorMat : parallelMat;
			const line = new THREE.LineLoop(
				createParallelGeometry(r, lat),
				mat,
			);
			if (dashed) line.computeLineDistances();
			planetGroup.add(line);
		}

		// Earth reference lines — independent of gridResolution, always
		// at their specific terrestrial values. Three tiers of material:
		//   tropics  → accent dashed
		//   polar    → foreground dashed
		//   meridians → accent solid (prime) / foreground solid (antimeridian)
		const earthTropicsMat = dashed
			? new THREE.LineDashedMaterial({
					color: 0xf04000,
					transparent: true,
					opacity: 0.75,
					dashSize: 0.05,
					gapSize: 0.03,
				})
			: new THREE.LineBasicMaterial({
					color: 0xf04000,
					transparent: true,
					opacity: 0.65,
				});

		const earthPolarMat = dashed
			? new THREE.LineDashedMaterial({
					color: 0xd6d3ce,
					transparent: true,
					opacity: 0.6,
					dashSize: 0.05,
					gapSize: 0.03,
				})
			: new THREE.LineBasicMaterial({
					color: 0xd6d3ce,
					transparent: true,
					opacity: 0.55,
				});

		const earthMeridianMat = dashed
			? new THREE.LineDashedMaterial({
					color: 0xf04000,
					transparent: true,
					opacity: 0.7,
					dashSize: 0.05,
					gapSize: 0.03,
				})
			: new THREE.LineBasicMaterial({
					color: 0xf04000,
					transparent: true,
					opacity: 0.6,
				});

		const earthAntimeridianMat = dashed
			? new THREE.LineDashedMaterial({
					color: 0xd6d3ce,
					transparent: true,
					opacity: 0.5,
					dashSize: 0.05,
					gapSize: 0.03,
				})
			: new THREE.LineBasicMaterial({
					color: 0xd6d3ce,
					transparent: true,
					opacity: 0.45,
				});

		// Tropics of Cancer (23.5° N) and Capricorn (23.5° S)
		for (const lat of [23.5, -23.5]) {
			const line = new THREE.LineLoop(
				createParallelGeometry(r, lat, 128),
				earthTropicsMat,
			);
			if (dashed) line.computeLineDistances();
			planetGroup.add(line);
		}

		// Arctic Circle (66.5° N) and Antarctic Circle (66.5° S)
		for (const lat of [66.5, -66.5]) {
			const line = new THREE.LineLoop(
				createParallelGeometry(r, lat, 128),
				earthPolarMat,
			);
			if (dashed) line.computeLineDistances();
			planetGroup.add(line);
		}

		// Prime Meridian (0°) — the reference longitude
		const primeLine = new THREE.LineLoop(
			createMeridianGeometry(r, 0, 128),
			earthMeridianMat,
		);
		if (dashed) primeLine.computeLineDistances();
		planetGroup.add(primeLine);

		// Antimeridian (180°)
		const antiLine = new THREE.LineLoop(
			createMeridianGeometry(r, 180, 128),
			earthAntimeridianMat,
		);
		if (dashed) antiLine.computeLineDistances();
		planetGroup.add(antiLine);

		lastGridDashed = dashed;

		// Re-attach the planet marker if a planet point is currently selected
		// (planetGroup is wiped on every rebuild, so the sprite is gone too).
		if (planetMarkerLat !== null && planetMarkerLon !== null) {
			createPlanetMarker(planetMarkerLat, planetMarkerLon);
		}
	}

	// === Scene init ===
	function initScene(): void {
		const canvas = document.getElementById("orbital-canvas");
		const staticFallback = document.getElementById("orbital-static");

		if (prefersReducedMotion) {
			canvas?.setAttribute("hidden", "");
			staticFallback?.removeAttribute("hidden");
			return;
		}

		// Cache readout elements
		readoutEls.fps = document.querySelector('[data-readout="fps"]');
		readoutEls.time = document.querySelector('[data-readout="time"]');
		readoutEls.sats = document.querySelector('[data-readout="sats"]');
		readoutEls.focus = document.querySelector('[data-readout="focus"]');
		readoutEls.azi = document.querySelector('[data-readout="azi"]');
		readoutEls.ele = document.querySelector('[data-readout="ele"]');
		readoutEls.range = document.querySelector('[data-readout="range"]');
		readoutEls.hdg = document.querySelector('[data-readout="hdg"]');
		readoutEls.scale = document.querySelector('[data-readout="scale"]');

		const container = canvas!;
		const width = container.clientWidth;
		const height = container.clientHeight;
		canvasHeight = height;

		scene = new THREE.Scene();

		camera = new THREE.PerspectiveCamera(45, width / height, 0.1, 100);
		camera.position.set(0, 3, 7);
		camera.lookAt(0, 0, 0);

		renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
		renderer.setSize(width, height);
		renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
		container.appendChild(renderer.domElement);

		labelRenderer = new CSS2DRenderer();
		labelRenderer.setSize(width, height);
		labelRenderer.domElement.style.position = "absolute";
		labelRenderer.domElement.style.top = "0";
		labelRenderer.domElement.style.pointerEvents = "none";
		container.appendChild(labelRenderer.domElement);

		controls = new OrbitControls(camera, renderer.domElement);
		controls.enableDamping = true;
		controls.dampingFactor = 0.05;
		controls.minDistance = 4;
		controls.maxDistance = 15;
		controls.addEventListener("start", () => {
			// Drag pauses only the camera orbit, not the planet spin
			config.cameraOrbit = false;
			const toggle = document.querySelector<HTMLInputElement>(
				'input[data-config="cameraOrbit"]',
			);
			if (toggle) toggle.checked = false;
			clearTimeout(interactionTimeout);
		});
		controls.addEventListener("end", () => {
			interactionTimeout = setTimeout(() => {
				config.cameraOrbit = true;
				const toggle = document.querySelector<HTMLInputElement>(
					'input[data-config="cameraOrbit"]',
				);
				if (toggle) toggle.checked = true;
			}, 3000);
		});

		// Starfield backdrop
		starfield = buildStarfield(600);
		scene.add(starfield);

		// Apple Watch Ultra–style compass + camera ray
		buildCompass();

		// Orbital group (rotates as a whole when auto-rotate is on)
		orbitalGroup = new THREE.Group();
		orbitalGroup.rotation.x = 0.3;
		scene.add(orbitalGroup);

		// Planet group (with meridians/parallels, rotates around its own axis)
		planetGroup = new THREE.Group();
		orbitalGroup.add(planetGroup);
		buildPlanetGrid();

		// Shared satellite material
		satelliteMaterial = new THREE.MeshBasicMaterial({
			color: 0xf04000,
			side: THREE.DoubleSide,
		});

		// Build satellites + orbits
		satelliteData.forEach((data, i) => {
			const orbitGroup = new THREE.Group();
			orbitGroup.rotation.x = data.inclination;
			orbitGroup.rotation.y = data.azimut;
			orbitalGroup.add(orbitGroup);

			const orbitMat = createOrbitMaterial(
				config.orbitColor,
				config.dashed,
			);
			const orbitLine = new THREE.LineLoop(
				createCircleGeometry(config.orbitRadii[i]),
				orbitMat,
			);
			if (config.dashed) orbitLine.computeLineDistances();
			orbitGroup.add(orbitLine);

			const mesh = new THREE.Mesh(
				buildSatelliteGeometry(
					config.satelliteShape,
					config.satelliteSize,
				),
				satelliteMaterial,
			);
			mesh.position.set(config.orbitRadii[i], 0, 0);
			orbitGroup.add(mesh);

			const labelDiv = document.createElement("div");
			labelDiv.className = "orbital-label";
			labelDiv.textContent = data.name;
			const label = new CSS2DObject(labelDiv);
			label.position.set(0, 0.25, 0);
			mesh.add(label);

			satellites.push({
				mesh,
				orbitGroup,
				orbitLine,
				orbitLineMaterial: orbitMat,
				orbitSpeed: data.orbitSpeed,
				satSpeed: data.satSpeed,
				angle: Math.random() * Math.PI * 2,
				radius: config.orbitRadii[i],
				dataIndex: i,
			});
		});

		setupControls();

		// Reticle texture (used for both satellite reticle and planet marker)
		reticleTexture = createReticleTexture();

		// Hover/click on satellites and planet
		setupInteraction();

		fpsFrames = 0;
		fpsLastUpdate = performance.now();
		scanStart = performance.now();
		lastReadoutUpdate = 0;
		lastFrameTime = performance.now();
		animate();

		function onResize(): void {
			const w = container.clientWidth;
			const h = container.clientHeight;
			camera.aspect = w / h;
			camera.updateProjectionMatrix();
			renderer.setSize(w, h);
			labelRenderer.setSize(w, h);
		}
		window.addEventListener("resize", onResize);
	}

	// === Animation ===
	function animate(): void {
		animationId = requestAnimationFrame(animate);

		const now = performance.now();
		const dt =
			lastFrameTime === 0
				? 0
				: Math.min((now - lastFrameTime) / 1000, 0.1);
		lastFrameTime = now;

		// Camera orbit: rotates the camera around the planet's Y axis at
		// the current distance and elevation (both preserved). Independent
		// from the planet's own self-rotation.
		if (config.cameraOrbit) {
			const camPos = camera.position;
			const distance = camPos.length();
			if (distance > 0) {
				const elevation = Math.asin(camPos.y / distance);
				const azimuth = Math.atan2(camPos.x, camPos.z);
				const azIncrement =
					0.2 * config.cameraOrbitSpeed * dt;
				const newAzimuth = azimuth + azIncrement;
				const horizR = distance * Math.cos(elevation);
				camera.position.set(
					horizR * Math.sin(newAzimuth),
					distance * Math.sin(elevation),
					horizR * Math.cos(newAzimuth),
				);
			}
		}

		// Planet self-rotation: spins planetGroup on its own Y axis. Fully
		// independent from the camera orbit — the user can drag the camera
		// while the planet keeps spinning.
		if (config.planetSpin) {
			planetGroup.rotation.y += 0.5 * config.planetSpinSpeed * dt;
		}

		satellites.forEach((sat) => {
			sat.orbitGroup.rotation.y += sat.orbitSpeed * 0.015;
			sat.angle += sat.satSpeed * 0.015;
			sat.mesh.position.x = Math.cos(sat.angle) * sat.radius;
			sat.mesh.position.z = Math.sin(sat.angle) * sat.radius;

			// Billboard: satellite always faces the camera. lookAt uses
			// world space, so the parent orbitGroup's rotation is
			// accounted for automatically.
			sat.mesh.lookAt(camera.position);
		});

		// Update camera ray: line from origin to camera world position
		if (cameraRay) {
			const camPos = camera.position;
			const rayAttr = cameraRay.geometry.attributes.position as THREE.BufferAttribute;
			rayAttr.setXYZ(0, 0, 0, 0);
			rayAttr.setXYZ(1, camPos.x, camPos.y, camPos.z);
			rayAttr.needsUpdate = true;
		}

		// Camera reset tween (ease-out cubic). Runs before controls.update
		// so OrbitControls picks up the new position this frame.
		if (cameraResetAnim) {
			const elapsed = performance.now() - cameraResetAnim.startTime;
			const t = Math.min(elapsed / cameraResetAnim.duration, 1);
			const ease = 1 - Math.pow(1 - t, 3);
			camera.position.lerpVectors(
				cameraResetAnim.startPos,
				cameraResetAnim.endPos,
				ease,
			);
			if (t >= 1) cameraResetAnim = null;
		}

		controls.update();
		renderer.render(scene, camera);
		labelRenderer.render(scene, camera);

		updateReadouts();
	}

	function updateReadouts(): void {
		fpsFrames++;
		const now = performance.now();

		// Throttle DOM writes to 4Hz to avoid layout thrash
		if (now - lastReadoutUpdate < 250) return;
		lastReadoutUpdate = now;

		const elapsed = now - fpsLastUpdate;
		if (elapsed > 0 && readoutEls.fps) {
			const fps = Math.round((fpsFrames * 1000) / elapsed);
			readoutEls.fps.textContent = String(fps).padStart(2, "0");
		}
		fpsFrames = 0;
		fpsLastUpdate = now;

		if (readoutEls.time) {
			const t = Math.floor((now - scanStart) / 1000);
			const h = String(Math.floor(t / 3600)).padStart(2, "0");
			const m = String(Math.floor((t % 3600) / 60)).padStart(2, "0");
			const s = String(t % 60).padStart(2, "0");
			readoutEls.time.textContent = `${h}:${m}:${s}`;
		}

		if (readoutEls.focus) {
			const fmt = (n: number) => (n >= 0 ? "+" : "") + n.toFixed(2);
			readoutEls.focus.textContent = `${fmt(orbitalGroup.rotation.y)} / ${fmt(orbitalGroup.rotation.x)}`;
		}

		if (readoutEls.sats) {
			readoutEls.sats.textContent = String(satellites.length).padStart(
				2,
				"0",
			);
		}

		// Camera spherical coordinates (camera always looks at origin)
		const camPos = camera.position;
		const range = camPos.length();
		if (range > 0) {
			const elevation = (Math.asin(camPos.y / range) * 180) / Math.PI;
			const azimuthRaw = (Math.atan2(camPos.x, camPos.z) * 180) / Math.PI;
			const azimuth = (azimuthRaw + 360) % 360;

			if (readoutEls.azi) {
				readoutEls.azi.textContent =
					String(Math.round(azimuth)).padStart(3, "0") + "°";
			}
			if (readoutEls.ele) {
				const sign = elevation >= 0 ? "+" : "";
				readoutEls.ele.textContent =
					sign + elevation.toFixed(1) + "°";
			}
			if (readoutEls.range) {
				readoutEls.range.textContent = range.toFixed(2);
			}
			if (readoutEls.hdg) {
				const dirs = [
					"N",
					"NE",
					"E",
					"SE",
					"S",
					"SW",
					"W",
					"NW",
				];
				readoutEls.hdg.textContent =
					dirs[Math.round(azimuth / 45) % 8];
			}

			// Reference scale: world units represented by the 64px scale bar
			// at the current camera distance. visibleHeight = 2·d·tan(fov/2).
			if (readoutEls.scale && canvasHeight > 0) {
				const fovRad = (45 * Math.PI) / 180;
				const visibleHeight = 2 * range * Math.tan(fovRad / 2);
				const worldUnitsPerPixel = visibleHeight / canvasHeight;
				const scaleBarWorldUnits = 64 * worldUnitsPerPixel;
				readoutEls.scale.textContent =
					scaleBarWorldUnits.toFixed(2) + "u";
			}
		}
	}

	// === Config application ===
	function applyConfig(): void {
		// Satellite shape/size: swap geometry in place
		satellites.forEach((sat) => {
			sat.mesh.geometry.dispose();
			sat.mesh.geometry = buildSatelliteGeometry(
				config.satelliteShape,
				config.satelliteSize,
			);
		});

		// Orbit radii: rebuild line geometry
		satellites.forEach((sat) => {
			sat.radius = config.orbitRadii[sat.dataIndex];
			sat.orbitLine.geometry.dispose();
			sat.orbitLine.geometry = createCircleGeometry(sat.radius);
			if (config.dashed) sat.orbitLine.computeLineDistances();
		});

		// Orbit material: swap type if dash toggle changed, else just update color
		satellites.forEach((sat) => {
			const isDashed =
				sat.orbitLineMaterial instanceof THREE.LineDashedMaterial;
			if (isDashed !== config.dashed) {
				sat.orbitLineMaterial.dispose();
				sat.orbitLineMaterial = createOrbitMaterial(
					config.orbitColor,
					config.dashed,
				);
				sat.orbitLine.material = sat.orbitLineMaterial;
				if (config.dashed) sat.orbitLine.computeLineDistances();
			} else {
				sat.orbitLineMaterial.color.setHex(config.orbitColor);
			}
		});

		// Planet grid: rebuild only if the dashed toggle actually changed.
		// gridResolution changes go through handleButton → buildPlanetGrid directly.
		if (lastGridDashed !== config.dashed) {
			buildPlanetGrid();
		}
	}

	// === Interaction ===
	function createReticleTexture(): THREE.CanvasTexture {
		const canvas = document.createElement("canvas");
		canvas.width = canvas.height = 64;
		const ctx = canvas.getContext("2d")!;
		ctx.strokeStyle = "#f04000";
		ctx.lineWidth = 2.5;
		ctx.beginPath();
		ctx.arc(32, 32, 26, 0, Math.PI * 2);
		ctx.stroke();
		ctx.beginPath();
		ctx.moveTo(32, 20);
		ctx.lineTo(32, 44);
		ctx.moveTo(20, 32);
		ctx.lineTo(44, 32);
		ctx.stroke();
		const tex = new THREE.CanvasTexture(canvas);
		tex.colorSpace = THREE.SRGBColorSpace;
		return tex;
	}

	function getSatLabel(sat: Satellite): CSS2DObject | null {
		for (const child of sat.mesh.children) {
			if (child instanceof CSS2DObject) return child;
		}
		return null;
	}

	function ndcFromEvent(event: PointerEvent): { x: number; y: number } {
		const rect = renderer.domElement.getBoundingClientRect();
		return {
			x: ((event.clientX - rect.left) / rect.width) * 2 - 1,
			y: -((event.clientY - rect.top) / rect.height) * 2 + 1,
		};
	}

	function setHoverStyle(sat: Satellite | null): void {
		if (hoveredSatellite && hoveredSatellite !== sat) {
			const lbl = getSatLabel(hoveredSatellite);
			if (lbl) {
				lbl.element.style.opacity = "";
				lbl.element.style.fontWeight = "";
			}
		}
		hoveredSatellite = sat;
		if (sat) {
			const lbl = getSatLabel(sat);
			if (lbl) {
				lbl.element.style.opacity = "1";
				lbl.element.style.fontWeight = "700";
			}
			renderer.domElement.style.cursor = "pointer";
		} else {
			renderer.domElement.style.cursor = "grab";
		}
	}

	function onPointerMove(event: PointerEvent): void {
		const ndc = ndcFromEvent(event);
		pointer.set(ndc.x, ndc.y);
		raycaster.setFromCamera(pointer, camera);
		const satMeshes = satellites.map((s) => s.mesh);
		const hits = raycaster.intersectObjects(satMeshes, false);
		const hit = hits.length > 0 ? hits[0].object : null;
		const sat = hit
			? satellites.find((s) => s.mesh === hit) ?? null
			: null;
		setHoverStyle(sat);
	}

	function onPointerDown(event: PointerEvent): void {
		// Any user interaction cancels an in-flight camera reset
		cameraResetAnim = null;
		pointerDownInfo = {
			x: event.clientX,
			y: event.clientY,
			time: performance.now(),
		};
	}

	function onPointerUp(event: PointerEvent): void {
		const info = pointerDownInfo;
		pointerDownInfo = null;
		if (!info) return;
		const dx = event.clientX - info.x;
		const dy = event.clientY - info.y;
		const dt = performance.now() - info.time;
		if (Math.sqrt(dx * dx + dy * dy) < 5 && dt < 500) {
			handleClick(event);
		}
	}

	function onPointerLeave(): void {
		setHoverStyle(null);
	}

	function handleClick(event: PointerEvent): void {
		const ndc = ndcFromEvent(event);
		pointer.set(ndc.x, ndc.y);
		raycaster.setFromCamera(pointer, camera);

		// Satellites first
		const satMeshes = satellites.map((s) => s.mesh);
		const satHits = raycaster.intersectObjects(satMeshes, false);
		if (satHits.length > 0) {
			const sat = satellites.find(
				(s) => s.mesh === satHits[0].object,
			);
			if (sat) {
				selectSatellite(sat);
				return;
			}
		}

		// Planet sphere (in world space — planet is centered at origin)
		const planetSphere = new THREE.Sphere(
			new THREE.Vector3(0, 0, 0),
			0.8,
		);
		const worldHit = new THREE.Vector3();
		if (raycaster.ray.intersectSphere(planetSphere, worldHit)) {
			selectPlanetPoint(worldHit);
			return;
		}

		deselectAll();
	}

	function addSatelliteReticle(sat: Satellite): void {
		const existing = sat.mesh.getObjectByName("reticle");
		if (existing) {
			sat.mesh.remove(existing);
			(existing as THREE.Sprite).material.dispose();
		}
		if (!reticleTexture) return;
		const mat = new THREE.SpriteMaterial({
			map: reticleTexture,
			color: 0xf04000,
			transparent: true,
			opacity: 0.9,
			depthTest: false,
		});
		const reticle = new THREE.Sprite(mat);
		reticle.name = "reticle";
		reticle.scale.set(0.35, 0.35, 1);
		reticle.renderOrder = 999;
		sat.mesh.add(reticle);
	}

	function selectSatellite(sat: Satellite): void {
		// Clear any planet selection
		if (planetMarker) {
			planetMarker.parent?.remove(planetMarker);
			(planetMarker.material as THREE.Material).dispose();
			planetMarker = null;
			planetMarkerLat = null;
			planetMarkerLon = null;
		}

		// Reticle on the newly-selected satellite; remove any previous
		if (selectedSatellite && selectedSatellite !== sat) {
			const old = selectedSatellite.mesh.getObjectByName("reticle");
			if (old) {
				selectedSatellite.mesh.remove(old);
				(old as THREE.Sprite).material.dispose();
			}
		}

		selectedSatellite = sat;
		addSatelliteReticle(sat);

		const data = satelliteData[sat.dataIndex];
		setTargetPanel("sat", {
			name: data.name,
			radius: sat.radius.toFixed(2) + "u",
			incl:
				((data.inclination * 180) / Math.PI).toFixed(1) + "°",
			spd: data.orbitSpeed.toFixed(2),
		});
	}

	function createPlanetMarker(lat: number, lon: number): void {
		if (planetMarker) {
			planetMarker.parent?.remove(planetMarker);
			(planetMarker.material as THREE.Material).dispose();
		}
		if (!reticleTexture) return;
		const latRad = (lat * Math.PI) / 180;
		const lonRad = (lon * Math.PI) / 180;
		const localPos = new THREE.Vector3(
			Math.cos(latRad) * Math.sin(lonRad),
			Math.sin(latRad),
			Math.cos(latRad) * Math.cos(lonRad),
		).multiplyScalar(0.8);

		const mat = new THREE.SpriteMaterial({
			map: reticleTexture,
			color: 0xf04000,
			transparent: true,
			opacity: 0.9,
			depthTest: false,
		});
		planetMarker = new THREE.Sprite(mat);
		planetMarker.scale.set(0.22, 0.22, 1);
		planetMarker.position.copy(localPos);
		planetMarker.renderOrder = 999;
		planetGroup.add(planetMarker);
	}

	function selectPlanetPoint(worldPoint: THREE.Vector3): void {
		// Clear any satellite selection (remove reticle)
		if (selectedSatellite) {
			const r = selectedSatellite.mesh.getObjectByName("reticle");
			if (r) {
				selectedSatellite.mesh.remove(r);
				(r as THREE.Sprite).material.dispose();
			}
			selectedSatellite = null;
		}

		// Convert to planet's local frame, then derive lat/long.
		// The marker lives in planetGroup's local space so it rotates with
		// the planet and stays at the same lat/long.
		const localPoint = planetGroup.worldToLocal(worldPoint.clone());
		const r = localPoint.length();
		const lat = (Math.asin(localPoint.y / r) * 180) / Math.PI;
		const lonRaw = (Math.atan2(localPoint.x, localPoint.z) * 180) / Math.PI;
		// Earth convention: longitude in -180..+180, 0 at the prime meridian
		const lon = lonRaw > 180 ? lonRaw - 360 : lonRaw;
		planetMarkerLat = lat;
		planetMarkerLon = lon;
		createPlanetMarker(lat, lon);

		// Format with hemisphere indicator (terrestrial convention)
		const latHemi = lat >= 0 ? "N" : "S";
		const lonHemi = lon >= 0 ? "E" : "W";
		const latStr = Math.abs(lat).toFixed(1) + "°" + latHemi;
		const lonStr = Math.abs(lon).toFixed(1) + "°" + lonHemi;

		setTargetPanel("planet", {
			lat: latStr,
			lon: lonStr,
		});
	}

	function deselectAll(): void {
		if (selectedSatellite) {
			const r = selectedSatellite.mesh.getObjectByName("reticle");
			if (r) {
				selectedSatellite.mesh.remove(r);
				(r as THREE.Sprite).material.dispose();
			}
			selectedSatellite = null;
		}
		if (planetMarker) {
			planetMarker.parent?.remove(planetMarker);
			(planetMarker.material as THREE.Material).dispose();
			planetMarker = null;
			planetMarkerLat = null;
			planetMarkerLon = null;
		}
		hideTargetPanels();
	}

	function setTargetPanel(
		kind: "sat" | "planet",
		values: Record<string, string>,
	): void {
		const satPanel = document.getElementById("orbital-target-sat");
		const planetPanel = document.getElementById(
			"orbital-target-planet",
		);
		if (!satPanel || !planetPanel) return;
		satPanel.classList.add("hidden");
		planetPanel.classList.add("hidden");

		const panel = kind === "sat" ? satPanel : planetPanel;
		panel.classList.remove("hidden");
		for (const [key, value] of Object.entries(values)) {
			const el = panel.querySelector(
				`[data-target-${kind}="${key}"]`,
			);
			if (el) el.textContent = value;
		}
	}

	function hideTargetPanels(): void {
		document
			.getElementById("orbital-target-sat")
			?.classList.add("hidden");
		document
			.getElementById("orbital-target-planet")
			?.classList.add("hidden");
	}

	function setupInteraction(): void {
		const canvas = renderer.domElement;
		canvas.style.cursor = "grab";
		canvas.addEventListener("pointermove", onPointerMove);
		canvas.addEventListener("pointerdown", onPointerDown);
		canvas.addEventListener("pointerup", onPointerUp);
		canvas.addEventListener("pointerleave", onPointerLeave);
	}

	function resetCamera(): void {
		cameraResetAnim = {
			startPos: camera.position.clone(),
			endPos: new THREE.Vector3(0, 3, 7),
			startTime: performance.now(),
			duration: 600,
		};
		// Make sure we're aimed back at the planet center
		controls.target.set(0, 0, 0);
	}

	// === Control wiring ===
	function isSatelliteShape(v: string): v is SatelliteShape {
		return v === "triangle" || v === "sphere" || v === "diamond";
	}

	function isGridResolution(n: number): n is GridResolution {
		return n === 10 || n === 20 || n === 30 || n === 45;
	}

	function setupControls(): void {
		const root = document.getElementById("orbital-container");
		if (!root) return;

		// range / color / checkbox inputs
		root.querySelectorAll<HTMLInputElement>("input[data-config]").forEach(
			(input) => {
				const handler = () => handleInput(input);
				input.addEventListener("input", handler);
				input.addEventListener("change", handler);
			},
		);

		// button groups (shape, grid resolution)
		root.querySelectorAll<HTMLButtonElement>(
			"button[data-config][data-value]",
		).forEach((btn) => {
			btn.addEventListener("click", () => handleButton(btn));
		});
	}

	function handleInput(input: HTMLInputElement): void {
		const key = input.dataset.config;
		if (!key) return;

		if (input.type === "checkbox") {
			if (key === "cameraOrbit") config.cameraOrbit = input.checked;
			else if (key === "planetSpin") config.planetSpin = input.checked;
			else if (key === "dashed") {
				config.dashed = input.checked;
				applyConfig();
			}
			return;
		}

		if (input.type === "range" || input.type === "color") {
			if (key === "cameraOrbitSpeed") {
				config.cameraOrbitSpeed = parseFloat(input.value);
				return; // no geometry rebuild
			}
			if (key === "planetSpinSpeed") {
				config.planetSpinSpeed = parseFloat(input.value);
				return;
			}
			if (key === "satelliteSize") {
				config.satelliteSize = parseFloat(input.value);
			} else if (key === "orbitRadius") {
				const idx = parseInt(input.dataset.index ?? "0", 10);
				if (idx >= 0 && idx < 3) {
					config.orbitRadii[idx] = parseFloat(input.value);
				}
			} else if (key === "orbitColor") {
				config.orbitColor = parseInt(
					input.value.replace("#", ""),
					16,
				);
			}
			applyConfig();
		}
	}

	function handleButton(btn: HTMLButtonElement): void {
		const action = btn.dataset.action;
		if (action === "resetCamera") {
			resetCamera();
			return;
		}

		const key = btn.dataset.config;
		const value = btn.dataset.value;
		if (!key || value === undefined) return;

		if (key === "satelliteShape" && isSatelliteShape(value)) {
			config.satelliteShape = value;
		} else if (key === "gridResolution") {
			const n = parseInt(value, 10);
			if (isGridResolution(n)) {
				config.gridResolution = n;
				buildPlanetGrid();
			}
		} else {
			return;
		}

		// Update active state within sibling group
		const group = btn.parentElement;
		if (group) {
			group
				.querySelectorAll<HTMLButtonElement>("button[data-config]")
				.forEach((b) => {
					b.classList.toggle("orbital-hud-btn--active", b === btn);
				});
		}

		if (key === "satelliteShape") applyConfig();
	}

	// === Teardown ===
	function destroyScene(): void {
		cancelAnimationFrame(animationId);
		clearTimeout(interactionTimeout);

		if (renderer) {
			renderer.dispose();
			renderer.domElement.remove();
		}
		if (labelRenderer) {
			// CSS2DRenderer holds label DOM nodes as children of its domElement.
			// Strip them before removing the container, otherwise the label
			// elements (referenced by CSS2DObject.element) leak.
			while (labelRenderer.domElement.firstChild) {
				labelRenderer.domElement.removeChild(
					labelRenderer.domElement.firstChild,
				);
			}
			labelRenderer.domElement.remove();
		}
		if (controls) {
			controls.dispose();
		}

		if (scene) {
			scene.traverse((obj) => {
				const disposable = obj as THREE.Object3D & {
					geometry?: THREE.BufferGeometry;
					material?: THREE.Material | THREE.Material[];
				};
				if (disposable.geometry) disposable.geometry.dispose();
				if (disposable.material) {
					if (Array.isArray(disposable.material)) {
						disposable.material.forEach((m) => m.dispose());
					} else {
						disposable.material.dispose();
					}
				}
			});
		}

		satellites = [];
		starfield = null;
		compass = null;
		cameraRay = null;
		hoveredSatellite = null;
		selectedSatellite = null;
		planetMarker = null;
		planetMarkerLat = null;
		planetMarkerLon = null;
		if (reticleTexture) {
			reticleTexture.dispose();
			reticleTexture = null;
		}
		pointerDownInfo = null;
		cameraResetAnim = null;
		lastFrameTime = 0;
	}

	document.addEventListener("astro:after-swap", destroyScene);
	document.addEventListener("astro:page-load", initScene);
</script>
