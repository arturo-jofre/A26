---
interface Props {
  company: string;
  jobtitle: string;
  period: string;
  companylogo?: string;
}
const { company, jobtitle, period, companylogo } = Astro.props;
---
<div class="flex gap-4 border-b border-border pb-6 last:border-0 last:pb-0 group">
  <div class="w-12 h-12 rounded-full bg-white/5 flex items-center justify-center flex-shrink-0 border border-border group-hover:border-accent/50 transition-colors">
    {companylogo && companylogo !== "/" ? (
      <img src={companylogo} alt={company} class="w-8 h-8 object-contain" />
    ) : (
      <span class="text-lg font-bold text-muted group-hover:text-accent transition-colors">{company.charAt(0)}</span>
    )}
  </div>
  <div>
    <h3 class="text-lg font-semibold text-foreground group-hover:text-accent transition-colors">{jobtitle}</h3>
    <div class="flex flex-col sm:flex-row sm:items-center gap-1 sm:gap-3 text-sm text-muted mt-1">
      <span class="font-medium text-white">{company}</span>
      <span class="hidden sm:inline text-border">&bull;</span>
      <span class="font-mono text-xs">{period}</span>
    </div>
  </div>
</div>
