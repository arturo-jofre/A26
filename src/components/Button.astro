---
interface Props {
  href?: string;
  variant?: "primary" | "outline" | "ghost";
  size?: "sm" | "md" | "lg";
  class?: string;
}

const {
  href,
  variant = "primary",
  size = "md",
  class: className = "",
} = Astro.props;

const baseClasses =
  "inline-flex items-center justify-center font-medium transition-all duration-300 focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2 focus:ring-offset-background active:scale-95";

const variants = {
  primary:
    "bg-accent text-white hover:bg-orange-600 shadow-lg shadow-accent/20",
  outline:
    "border border-border hover:border-accent hover:text-accent bg-transparent",
  ghost: "hover:bg-white/5 text-foreground hover:text-accent",
};

const sizes = {
  sm: "px-4 py-2 text-sm",
  md: "px-6 py-3 text-base",
  lg: "px-8 py-4 text-lg",
};

const Element = href ? "a" : "button";
---

<Element
  href={href}
  class:list={[baseClasses, variants[variant], sizes[size], className]}
>
  <slot />
</Element>
