---
import MonoMicrocopy from "./MonoMicrocopy.astro";
---

<footer class="border-t border-border mt-auto">
	<div class="mx-auto max-w-6xl px-4 sm:px-8 lg:px-12 py-10 flex flex-col gap-6">
		<MonoMicrocopy>// A26.SYS // SENIOR PRODUCT DESIGNER · SANTIAGO, CL</MonoMicrocopy>
		<div
			class="flex flex-col md:flex-row justify-between items-center gap-4 font-mono text-xs uppercase tracking-widest text-muted"
		>
			<p>
				&copy; {new Date().getFullYear()} ARTURO JOFRÉ LÓPEZ
			</p>
			<div class="flex gap-2">
				<a
					href="https://linkedin.com/in/arturojofre"
					target="_blank"
					rel="noopener"
					class="inline-flex items-center px-2 py-2 min-h-[44px] hover:text-foreground transition-colors"
					>LinkedIn</a
				>
				<a
					href="https://github.com/arturojofre"
					target="_blank"
					rel="noopener"
					class="inline-flex items-center px-2 py-2 min-h-[44px] hover:text-foreground transition-colors"
					>GitHub</a
				>
			</div>
		</div>
	</div>
</footer>
