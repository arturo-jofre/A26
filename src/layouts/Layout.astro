---
import { ClientRouter, fade } from "astro:transitions";
import "../styles/global.css";

interface Props {
	title: string;
	description?: string;
}

const { title, description = "Portafolio de Arturo Jofré - Product Designer" } =
	Astro.props;
---

<!doctype html>
<html
	lang="es"
	class="scroll-smooth"
	transition:name="root"
	transition:animate={fade({ duration: "0.16s" })}
>
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Geist+Mono:wght@100..900&family=Geist:wght@100..900&display=swap"
			rel="stylesheet"
		/>

		<ClientRouter />

		<!--
			Marca html.js solo cuando hay JS y el usuario acepta movimiento.
			Es la condición bajo la que global.css oculta los elementos
			[data-reveal] antes de animarlos: sin JS, o con prefers-reduced-motion,
			el contenido nunca se oculta. Los listeners viven en `document`, que
			persiste entre navegaciones, así que el flag sobrevive cada swap.
		-->
		<script is:inline>
			const reducedMotion = window.matchMedia(
				"(prefers-reduced-motion: reduce)"
			);
			const syncMotionFlag = () =>
				document.documentElement.classList.toggle("js", !reducedMotion.matches);
			syncMotionFlag();
			document.addEventListener("astro:after-swap", syncMotionFlag);
			document.addEventListener("astro:page-load", syncMotionFlag);
		</script>
	</head>
	<body
		class="antialiased min-h-screen flex flex-col relative overflow-x-hidden"
	>
		<a
			href="#main"
			class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:px-4 focus:py-2 focus:bg-accent focus:text-white focus:font-mono focus:text-xs focus:uppercase focus:tracking-widest focus:no-underline"
		>
			Saltar al contenido
		</a>
		<slot />

		<!--
			Un único punto de montaje para todas las animaciones del sitio.
			Es un módulo (se ejecuta una sola vez): los listeners de `document`
			persisten y siguen funcionando tras cada navegación client-side.
		-->
		<script>
			import { destroyMotion, initMotion } from "../scripts/motion-system";

			document.addEventListener("astro:after-swap", destroyMotion);
			document.addEventListener("astro:page-load", initMotion);

			// El primer montaje no puede depender de que `astro:page-load` llegue
			// después de este módulo: en el primer load esa carrera puede perderse
			// y el contenido quedaría oculto. initMotion() es idempotente.
			initMotion();
		</script>
	</body>
</html>
